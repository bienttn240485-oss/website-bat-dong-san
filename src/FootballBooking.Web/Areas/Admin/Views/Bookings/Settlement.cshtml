@model AdminBookingSettlementViewModel
@using FootballBooking.Domain.Bookings
@{
    ViewData["Title"] = "Quyết toán";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
            <h1 class="break-words text-xl font-semibold text-ink sm:text-2xl">Phiếu quyết toán</h1>
            <p class="mt-1 break-words text-sm font-medium text-ink">@Model.Booking.BookingCode</p>
            <p class="mt-1 text-sm text-muted">@Model.Booking.FieldName · @Model.Booking.BookingDate.ToString("dd/MM/yyyy") · @FormatMinute(Model.Booking.StartMinute) - @FormatMinute(Model.Booking.EndMinute)</p>
        </div>
        <a class="fb-button fb-button-secondary justify-center" href="/admin/bookings/@Model.Booking.Id">Quay lại booking</a>
    </div>

    <div class="grid gap-5 min-[1120px]:grid-cols-[1fr_0.75fr]">
        <section class="fb-card p-4">
            <div class="flex flex-col gap-3 border-b border-line pb-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <h2 class="font-semibold text-ink">Thông tin lượt đặt sân</h2>
                    <p class="mt-1 text-sm text-muted">Khách hàng: <span class="font-medium text-ink">@Model.Booking.CustomerName</span> · @Model.Booking.CustomerPhone</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(BookingLabels.Status(Model.Booking.Status), BookingLabels.StatusTone(Model.Booking.Status))' />
                    <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(BookingLabels.PaymentStatus(Model.Booking.PaymentStatus), Model.Booking.RemainingAmount > 0 ? "warning" : "success")' />
                </div>
            </div>

            <div class="mt-4 hidden overflow-x-auto sm:block">
                <table class="min-w-full text-left text-sm">
                    <thead class="border-b border-line text-xs uppercase text-muted">
                        <tr>
                            <th class="py-2 pr-3">Hạng mục</th>
                            <th class="py-2 pr-3">Diễn giải</th>
                            <th class="py-2 text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        <tr>
                            <td class="py-2 pr-3 font-medium text-ink">Tiền sân</td>
                            <td class="py-2 pr-3 text-muted">@FormatMinute(Model.Booking.StartMinute) - @FormatMinute(Model.Booking.EndMinute)</td>
                            <td class="py-2 text-right font-medium text-ink">@FormatMoney(Model.Booking.CourtAmount)</td>
                        </tr>
                        @foreach (var service in Model.Booking.ServiceLines)
                        {
                            <tr>
                                <td class="py-2 pr-3 font-medium text-ink">@service.ServiceName</td>
                                <td class="py-2 pr-3 text-muted">@service.Quantity @service.UnitName × @FormatMoney(service.UnitPrice)</td>
                                <td class="py-2 text-right font-medium text-ink">@FormatMoney(service.LineTotal)</td>
                            </tr>
                        }
                        @if (Model.Booking.DiscountAmount > 0)
                        {
                            <tr>
                                <td class="py-2 pr-3 font-medium text-ink">Khuyến mãi</td>
                                <td class="py-2 pr-3 text-muted">@(Model.Booking.PromoCodeSnapshot ?? "Đã áp dụng")</td>
                                <td class="py-2 text-right font-medium text-red-700">-@FormatMoney(Model.Booking.DiscountAmount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-t border-line text-sm">
                        <tr><td class="py-2 pr-3 text-muted" colspan="2">Tổng phải thu</td><td class="py-2 text-right font-semibold text-ink">@FormatMoney(Model.Booking.TotalAmount)</td></tr>
                        <tr><td class="py-2 pr-3 text-muted" colspan="2">Đã thu</td><td class="py-2 text-right font-semibold text-brand-900">@FormatMoney(Model.Booking.PaidAmount)</td></tr>
                        <tr><td class="py-2 pr-3 text-muted" colspan="2">Đã hoàn</td><td class="py-2 text-right font-semibold text-ink">@FormatMoney(Model.Booking.RefundedAmount)</td></tr>
                        <tr><td class="py-3 pr-3 text-base font-semibold text-ink" colspan="2">Còn thu</td><td class="py-3 text-right text-base font-semibold @(Model.Booking.RemainingAmount > 0 ? "text-amber-700" : "text-green-700")">@FormatMoney(Model.Booking.RemainingAmount)</td></tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4 space-y-3 sm:hidden">
                <div class="rounded-ui border border-line p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div><p class="font-medium text-ink">Tiền sân</p><p class="mt-1 text-sm text-muted">@FormatMinute(Model.Booking.StartMinute) - @FormatMinute(Model.Booking.EndMinute)</p></div>
                        <p class="shrink-0 font-semibold text-ink">@FormatMoney(Model.Booking.CourtAmount)</p>
                    </div>
                </div>
                @foreach (var service in Model.Booking.ServiceLines)
                {
                    <div class="rounded-ui border border-line p-3">
                        <div class="flex items-start justify-between gap-3">
                            <div><p class="font-medium text-ink">@service.ServiceName</p><p class="mt-1 text-sm text-muted">@service.Quantity @service.UnitName × @FormatMoney(service.UnitPrice)</p></div>
                            <p class="shrink-0 font-semibold text-ink">@FormatMoney(service.LineTotal)</p>
                        </div>
                    </div>
                }
                @if (Model.Booking.DiscountAmount > 0)
                {
                    <div class="rounded-ui border border-line p-3">
                        <div class="flex items-start justify-between gap-3">
                            <div><p class="font-medium text-ink">Khuyến mãi</p><p class="mt-1 text-sm text-muted">@(Model.Booking.PromoCodeSnapshot ?? "Đã áp dụng")</p></div>
                            <p class="shrink-0 font-semibold text-red-700">-@FormatMoney(Model.Booking.DiscountAmount)</p>
                        </div>
                    </div>
                }
                <div class="rounded-ui bg-slate-50 p-3 text-sm">
                    <div class="flex justify-between gap-3 py-1"><span class="text-muted">Tổng phải thu</span><span class="font-semibold text-ink">@FormatMoney(Model.Booking.TotalAmount)</span></div>
                    <div class="flex justify-between gap-3 py-1"><span class="text-muted">Đã thu</span><span class="font-semibold text-brand-900">@FormatMoney(Model.Booking.PaidAmount)</span></div>
                    <div class="flex justify-between gap-3 py-1"><span class="text-muted">Đã hoàn</span><span class="font-semibold text-ink">@FormatMoney(Model.Booking.RefundedAmount)</span></div>
                    <div class="mt-2 flex justify-between gap-3 border-t border-line pt-3 text-base"><span class="font-semibold text-ink">Còn thu</span><span class="font-semibold @(Model.Booking.RemainingAmount > 0 ? "text-amber-700" : "text-green-700")">@FormatMoney(Model.Booking.RemainingAmount)</span></div>
                </div>
            </div>
        </section>

        <section class="fb-card p-4">
            <h2 class="font-semibold text-ink">Xác nhận quyết toán</h2>
            @if (Model.Booking.RemainingAmount > 0)
            {
                <p class="mt-1 text-sm text-muted">Booking còn khoản phải thu. Ghi nhận thanh toán trước khi xác nhận hoàn thành nếu khách đã thanh toán tại sân.</p>
                <form class="mt-4 grid gap-3" method="post" action="/admin/bookings/@Model.Booking.Id/settlement/payments">
                    @Html.AntiForgeryToken()
                    <div><label class="fb-label" asp-for="PaymentForm.Amount"></label><input class="fb-input" asp-for="PaymentForm.Amount" type="number" min="1" name="Amount" /></div>
                    <div>
                        <label class="fb-label" asp-for="PaymentForm.Method"></label>
                        <select class="fb-input" asp-for="PaymentForm.Method" name="Method">
                            <option value="@PaymentMethod.Cash">Tiền mặt</option>
                            <option value="@PaymentMethod.BankTransfer">Chuyển khoản</option>
                            <option value="@PaymentMethod.Other">Khác</option>
                        </select>
                    </div>
                    <div><label class="fb-label" asp-for="PaymentForm.TransactionCode"></label><input class="fb-input" asp-for="PaymentForm.TransactionCode" name="TransactionCode" placeholder="Mã giao dịch nếu có" /></div>
                    <div><label class="fb-label" asp-for="PaymentForm.Note"></label><textarea class="fb-input" asp-for="PaymentForm.Note" name="Note" rows="3" placeholder="Ví dụ: Khách thanh toán phần còn lại tại sân"></textarea></div>
                    <button class="fb-button fb-button-primary justify-center" type="submit">Ghi nhận thanh toán</button>
                </form>
            }
            else
            {
                <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Đã thu đủ", "Booking không còn khoản phải thu. Có thể xác nhận hoàn thành sau khi khách kết thúc sử dụng sân.", "success")' />
            }

            <form class="mt-5 border-t border-line pt-4" method="post" action="/admin/bookings/@Model.Booking.Id/settlement/complete">
                @Html.AntiForgeryToken()
                @if (Model.Booking.RemainingAmount > 0)
                {
                    <p class="mb-3 text-sm text-amber-700">Vẫn có công nợ. Hệ thống cho phép hoàn thành nhưng sẽ giữ trạng thái thanh toán chưa đủ.</p>
                }
                <button class="fb-button fb-button-primary w-full justify-center" type="submit">Xác nhận hoàn thành</button>
            </form>
        </section>
    </div>

    <section class="fb-card p-4">
        <h2 class="font-semibold text-ink">Lịch sử thanh toán</h2>
        @if (Model.Booking.Payments.Count == 0)
        {
            <p class="mt-2 text-sm text-muted">Chưa ghi nhận giao dịch thanh toán.</p>
        }
        else
        {
            <div class="mt-3 grid gap-2 text-sm md:grid-cols-2">
                @foreach (var payment in Model.Booking.Payments)
                {
                    <div class="rounded-ui border border-line p-3">
                        <div class="flex flex-wrap items-center justify-between gap-2"><span class="font-medium text-ink">@BookingLabels.PaymentRecordType(payment.PaymentType) · @BookingLabels.PaymentMethod(payment.Method)</span><span class="font-semibold text-brand-900">@FormatMoney(payment.Amount)</span></div>
                        <p class="mt-1 text-xs text-muted">@BookingLabels.PaymentRecordStatus(payment.Status) · @(payment.ProcessedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</p>
                        @if (!string.IsNullOrWhiteSpace(payment.Note))
                        {
                            <p class="mt-2 text-sm text-muted">@payment.Note</p>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>
