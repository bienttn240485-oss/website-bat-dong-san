<header class="sticky top-0 z-30 border-b border-line bg-white">
    <div class="flex h-16 items-center justify-between gap-3 px-4 lg:px-6">
        <div class="flex items-center gap-3">
            <button class="fb-button fb-button-secondary px-3 lg:hidden" type="button" aria-label="Mở menu quản trị" data-hs-overlay="#admin-mobile-sidebar">
                <partial name="~/Views/Shared/Partials/_HeroIcon.cshtml" model='new HeroIconViewModel("menu")' />
            </button>
            <div>
                <p class="text-xs font-medium uppercase text-muted">Khu vực nội bộ</p>
                <h1 class="text-base font-semibold text-ink">@ViewData["Title"]</h1>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="hidden items-center rounded-ui border border-line bg-slate-50 px-3 py-2 text-sm text-muted sm:flex">
                <partial name="~/Views/Shared/Partials/_HeroIcon.cshtml" model='new HeroIconViewModel("clock", "mr-2 h-4 w-4")' />
                <span>25/07/2026 · 18:30</span>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="fb-button fb-button-secondary">Đăng xuất</button>
                </form>
            }
        </div>
    </div>
</header>
