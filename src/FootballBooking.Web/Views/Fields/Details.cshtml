@model FootballBooking.Web.ViewModels.Fields.FieldDetailPageViewModel
@using FootballBooking.Domain.Fields
@{
    ViewData["Title"] = Model.Field.Name;
    var cover = Model.Field.Images.FirstOrDefault(image => image.IsCover) ?? Model.Field.Images.FirstOrDefault();
    var coverPath = cover?.StoragePath is not null && !cover.StoragePath.EndsWith(".svg", StringComparison.OrdinalIgnoreCase)
        ? cover.StoragePath
        : Model.Field.Slug switch
        {
            "san-5b" => "https://images.unsplash.com/photo-1518091043644-c1d4457512c6?auto=format&fit=crop&w=1200&q=80",
            "san-7a" => "https://images.unsplash.com/photo-1577223625816-7546f13df25d?auto=format&fit=crop&w=1200&q=80",
            _ => "https://images.unsplash.com/photo-1556056504-5c7696c4c28d?auto=format&fit=crop&w=1200&q=80"
        };
}

@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫/giờ", amount).Replace(",", ".");
    private static string FormatMinute(int? minute)
    {
        if (minute is null)
        {
            return "--:--";
        }

        return $"{minute.Value / 60:00}:{minute.Value % 60:00}";
    }

    private static string DayName(int day) => day switch
    {
        0 => "Chủ nhật",
        1 => "Thứ hai",
        2 => "Thứ ba",
        3 => "Thứ tư",
        4 => "Thứ năm",
        5 => "Thứ sáu",
        6 => "Thứ bảy",
        _ => "Không rõ"
    };
}

<section class="border-b border-line bg-white">
    <div class="fb-container grid gap-6 py-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
            <nav class="mb-4 text-sm text-muted"><a class="hover:text-brand-800" href="/fields">Sân bóng</a> / <span class="font-medium text-ink">@Model.Field.Name</span></nav>
            <h1 class="text-3xl font-semibold text-ink">@Model.Field.Name</h1>
            <p class="mt-2 text-base text-muted">@Model.Field.FieldType · sức chứa @(Model.Field.Capacity?.ToString() ?? "linh hoạt") người</p>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-muted">@Model.Field.Description</p>
            <div class="mt-5 flex flex-wrap gap-2">
                @foreach (var amenity in Model.Field.Amenities)
                {
                    <span class="rounded-ui border border-brand-100 bg-brand-50 px-2 py-1 text-xs font-medium text-brand-800">@amenity</span>
                }
            </div>
        </div>
        <img class="fb-card aspect-[16/9] w-full object-cover" src="@coverPath" alt="@(cover?.AltText ?? Model.Field.Name)" />
    </div>
</section>

<section class="fb-container grid gap-5 py-8 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-5">
        <section class="fb-card overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Giờ hoạt động</h2>
            </div>
            <div class="grid divide-y divide-line">
                @foreach (var hour in Model.Field.OperatingHours)
                {
                    <div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                        <span class="font-medium text-ink">@DayName(hour.DayOfWeek)</span>
                        <span class="text-muted">@(hour.IsClosed ? "Đóng cửa" : $"{FormatMinute(hour.OpenMinute)} - {FormatMinute(hour.CloseMinute)}")</span>
                    </div>
                }
            </div>
        </section>

        <section class="fb-card overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Bảng giá tham khảo</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="fb-table">
                    <thead>
                        <tr>
                            <th>Tên giá</th>
                            <th>Khung giờ</th>
                            <th>Giá</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var rule in Model.Field.PricingRules.Where(rule => rule.IsActive))
                        {
                            <tr>
                                <td class="font-medium">@rule.Name</td>
                                <td>@FormatMinute(rule.StartMinute) - @FormatMinute(rule.EndMinute)</td>
                                <td>@FormatMoney(rule.PricePerHour)</td>
                                <td><partial name="Partials/_StatusBadge" model='new StatusBadgeViewModel("Đang áp dụng", "success")' /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="space-y-4">
        <section class="fb-card p-4">
            <h2 class="font-semibold text-ink">Thông tin sân</h2>
            <dl class="mt-3 grid gap-3 text-sm">
                <div class="flex justify-between gap-3"><dt class="text-muted">Mã sân</dt><dd class="font-medium text-ink">@Model.Field.Code</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-muted">Loại sân</dt><dd class="font-medium text-ink">@Model.Field.FieldType</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-muted">Đặt tối thiểu</dt><dd class="font-medium text-ink">@Model.Field.MinimumBookingMinutes phút</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-muted">Bước giờ</dt><dd class="font-medium text-ink">@Model.Field.SlotStepMinutes phút</dd></div>
            </dl>
            <form class="mt-4 grid gap-3" action="/booking" method="get">
                <input type="hidden" name="fieldId" value="@Model.Field.Id" />
                <div>
                    <label class="fb-label" for="date">Ngày muốn đặt</label>
                    <input class="fb-input" id="date" name="date" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1)).ToString("dd/MM/yyyy")" placeholder="dd/MM/yyyy" />
                </div>
                <button class="fb-button fb-button-primary w-full" type="submit">Đặt sân ngay</button>
            </form>
        </section>
    </aside>
</section>
