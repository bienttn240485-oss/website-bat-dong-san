@model IReadOnlyList<BreadcrumbItemViewModel>

@if (Model.Count > 0)
{
    <nav class="mb-4 flex items-center gap-2 text-sm text-muted" aria-label="Đường dẫn">
        @for (var i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            if (i > 0)
            {
                <partial name="Partials/_HeroIcon" model='new HeroIconViewModel("chevron-right", "h-4 w-4 text-slate-400")' />
            }

            if (!string.IsNullOrWhiteSpace(item.Url) && i < Model.Count - 1)
            {
                <a class="hover:text-brand-800" href="@item.Url">@item.Label</a>
            }
            else
            {
                <span class="font-medium text-ink">@item.Label</span>
            }
        }
    </nav>
}
