@model PromotionListViewModel
@{
    ViewData["Title"] = "Khuyến mãi";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatDiscount(PromoCodeDto promotion)
        => promotion.DiscountType == PromoDiscountType.FixedAmount
            ? FormatMoney(promotion.DiscountValue)
            : $"{promotion.DiscountValue / 100m:0.##}%";
}

<section class="border-b border-line bg-white">
    <div class="fb-container py-8">
        <p class="text-sm font-semibold uppercase text-brand-800">Khuyến mãi</p>
        <h1 class="mt-2 text-3xl font-semibold text-ink">Mã khuyến mãi đang áp dụng</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">Nhập mã trong bước đặt sân để hệ thống tự kiểm tra điều kiện và trừ tiền trên máy chủ.</p>
    </div>
</section>

<section class="fb-container py-8">
    <div class="grid gap-4 md:grid-cols-2">
        @foreach (var promotion in Model.Promotions)
        {
            <article class="fb-card p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <p class="text-sm font-semibold uppercase text-brand-800">@promotion.Code</p>
                        <h2 class="mt-1 font-semibold text-ink">@promotion.Name</h2>
                    </div>
                    <partial name="Partials/_StatusBadge" model='new StatusBadgeViewModel("Đang áp dụng", "success")' />
                </div>
                <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                    <div><dt class="text-muted">Ưu đãi</dt><dd class="font-semibold text-ink">@FormatDiscount(promotion)</dd></div>
                    <div><dt class="text-muted">Giá trị đặt sân tối thiểu</dt><dd class="font-semibold text-ink">@FormatMoney(promotion.MinimumOrderAmount)</dd></div>
                    <div><dt class="text-muted">Từ ngày</dt><dd class="font-semibold text-ink">@promotion.StartsAtUtc.ToString("dd/MM/yyyy")</dd></div>
                    <div><dt class="text-muted">Đến ngày</dt><dd class="font-semibold text-ink">@promotion.EndsAtUtc.ToString("dd/MM/yyyy")</dd></div>
                </dl>
            </article>
        }
    </div>
</section>
