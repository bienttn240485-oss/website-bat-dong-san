@model BookingSuccessViewModel
@{
    ViewData["Title"] = "Đặt sân thành công";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}

<section class="fb-container py-10">
    <div class="fb-card p-5">
        <partial name="Partials/_Alert" model='new AlertViewModel("Đã nhận yêu cầu đặt sân", "Vui lòng lưu mã đặt sân để tra cứu hoặc cung cấp cho nhân viên khi đến sân.", "success", "check-circle")' />
        <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
            <div><dt class="text-muted">Mã đặt sân</dt><dd class="font-semibold text-ink">@Model.Booking.BookingCode</dd></div>
            <div><dt class="text-muted">Sân</dt><dd class="font-semibold text-ink">@Model.Booking.FieldName</dd></div>
            <div><dt class="text-muted">Ngày</dt><dd class="font-semibold text-ink">@Model.Booking.BookingDate.ToString("dd/MM/yyyy")</dd></div>
            <div><dt class="text-muted">Khung giờ</dt><dd class="font-semibold text-ink">@FormatMinute(Model.Booking.StartMinute) - @FormatMinute(Model.Booking.EndMinute)</dd></div>
            <div><dt class="text-muted">Trạng thái</dt><dd><partial name="Partials/_StatusBadge" model='new StatusBadgeViewModel(BookingLabels.Status(Model.Booking.Status), BookingLabels.StatusTone(Model.Booking.Status))' /></dd></div>
            <div><dt class="text-muted">Thanh toán</dt><dd class="font-semibold text-ink">@BookingLabels.PaymentStatus(Model.Booking.PaymentStatus)</dd></div>
            <div><dt class="text-muted">Tiền sân</dt><dd class="font-semibold text-ink">@FormatMoney(Model.Booking.CourtAmount)</dd></div>
            <div><dt class="text-muted">Dịch vụ</dt><dd class="font-semibold text-ink">@FormatMoney(Model.Booking.ServiceAmount)</dd></div>
            <div><dt class="text-muted">Khuyến mãi</dt><dd class="font-semibold text-ink">-@FormatMoney(Model.Booking.DiscountAmount)</dd></div>
            <div><dt class="text-muted">Tổng tiền</dt><dd class="font-semibold text-ink">@FormatMoney(Model.Booking.TotalAmount)</dd></div>
        </dl>
        @if (Model.Booking.ServiceLines.Count > 0)
        {
            <div class="mt-5 border-t border-line pt-4">
                <h2 class="font-semibold text-ink">Dịch vụ đã chọn</h2>
                <div class="mt-3 grid gap-2 text-sm">
                    @foreach (var service in Model.Booking.ServiceLines)
                    {
                        <div class="flex justify-between gap-3">
                            <span class="text-muted">@service.ServiceName × @service.Quantity @service.UnitName</span>
                            <span class="font-medium text-ink">@FormatMoney(service.LineTotal)</span>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="mt-5 flex flex-wrap gap-3">
            <a class="fb-button fb-button-primary" href="/booking/lookup">Tra cứu đặt sân</a>
            <a class="fb-button fb-button-secondary" href="/fields">Xem sân khác</a>
        </div>
    </div>
</section>
