@{
    ViewData["Title"] = "Hệ thống giao diện";
}

<section class="fb-container space-y-8 py-8">
    <div>
        <h1 class="text-2xl font-semibold text-ink">Hệ thống giao diện</h1>
        <p class="mt-2 text-sm text-muted">Trang chỉ hiển thị trong môi trường phát triển để kiểm tra component dùng chung.</p>
    </div>

    <section class="grid gap-4 md:grid-cols-2">
        <div class="fb-card p-5">
            <h2 class="font-semibold text-ink">Màu sắc và nút</h2>
            <div class="mt-4 flex flex-wrap gap-2">
                <partial name="Partials/_Button" model='new ButtonViewModel("Hành động chính", "#", "primary", IconName: "calendar")' />
                <partial name="Partials/_Button" model='new ButtonViewModel("Hành động phụ", "#", "secondary")' />
                <partial name="Partials/_Button" model='new ButtonViewModel("Xóa dữ liệu mẫu", "#", "danger")' />
            </div>
            <div class="mt-5 grid grid-cols-3 gap-3 text-xs font-medium">
                <div class="rounded-ui bg-brand-700 p-3 text-white">Xanh sân bóng</div>
                <div class="rounded-ui bg-amber-50 p-3 text-amber-800">Cảnh báo</div>
                <div class="rounded-ui bg-slate-100 p-3 text-slate-700">Nền trung tính</div>
            </div>
        </div>

        <div class="fb-card p-5">
            <h2 class="font-semibold text-ink">Trường nhập liệu</h2>
            <div class="mt-4 grid gap-4">
                <partial name="Partials/_FormField" model='new FormFieldViewModel("demo-name", "Tên khách", Value: "Nguyễn Minh Tuấn", Hint: "Tên hiển thị trong phiếu đặt sân.", Required: true)' />
                <partial name="Partials/_FormField" model='new FormFieldViewModel("demo-phone", "Số điện thoại", Type: "tel", Value: "0901 234 567", Required: true)' />
            </div>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
        <partial name="Partials/_Alert" model='new AlertViewModel("Cập nhật thành công", "Thông tin mẫu đã được lưu trong phiên kiểm thử giao diện.", "success")' />
        <partial name="Partials/_Alert" model='new AlertViewModel("Cần kiểm tra", "Một số lịch đặt sân đang chờ xác nhận trước giờ bóng lăn.", "warning")' />
        <partial name="Partials/_Alert" model='new AlertViewModel("Thông tin", "Trang này không tạo dữ liệu nghiệp vụ trong hệ thống.", "info")' />
    </section>

    <section class="fb-card overflow-hidden">
        <div class="border-b border-line px-4 py-3">
            <h2 class="font-semibold text-ink">Bảng và trạng thái</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="fb-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line bg-white">
                    <tr>
                        <td>BK-20260725-001</td>
                        <td>Nguyễn Minh Tuấn</td>
                        <td><partial name="Partials/_StatusBadge" model='new StatusBadgeViewModel("Đã xác nhận", "info")' /></td>
                        <td>Đã đặt cọc</td>
                    </tr>
                    <tr>
                        <td>BK-20260725-002</td>
                        <td>Trần Quốc Huy</td>
                        <td><partial name="Partials/_StatusBadge" model='new StatusBadgeViewModel("Chờ thanh toán", "warning")' /></td>
                        <td>Còn 420.000 đ</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="px-4 py-3">
            <partial name="Partials/_PaginationShell" model="new PaginationShellViewModel(1, 4)" />
        </div>
    </section>

    <partial name="Partials/_EmptyState" model='new EmptyStateViewModel("Chưa có lịch bảo trì", "Khi Chủ sân tạo lịch khóa sân hoặc bảo trì, danh sách sẽ hiển thị tại đây.", "Tạo lịch bảo trì mẫu", "#")' />
    <button class="fb-button fb-button-danger" type="button" data-hs-overlay="#demo-confirm">Mở hộp xác nhận</button>
    <partial name="Partials/_ConfirmationModal" model='new ConfirmationModalViewModel("demo-confirm", "Xác nhận thao tác", "Đây là hộp xác nhận mẫu cho các thao tác có rủi ro.", "Xác nhận")' />
</section>
