@model TenantContractDetailViewModel

@{
    var contract = Model.Contract;
}

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Hợp đồng khách thuê @contract.PropertyCode</h2>
            <p class="mt-1 text-sm text-muted">@PropertyDisplay.ProjectLabel(contract.Project) · @contract.Area · @ContractDisplay.ContractStatusLabel(contract.Status)</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="fb-button fb-button-secondary" href="/admin/tenant-contracts">Danh sách</a>
            <a class="fb-button fb-button-primary" href="/admin/tenant-contracts/@contract.Id/edit">Sửa</a>
            @if (Model.CanDelete)
            {
                <form method="post" action="/admin/tenant-contracts/@contract.Id/delete" onsubmit="return confirm('Bạn chắc chắn muốn xóa hợp đồng khách thuê @contract.PropertyCode?');">
                    @Html.AntiForgeryToken()
                    <button class="fb-button fb-button-danger" type="submit">Xóa</button>
                </form>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Thành công", success, "success")' />
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Không thể thực hiện", error, "danger")' />
    }

    @foreach (var warning in Model.Warnings)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Cảnh báo", warning.Message, warning.Tone)' />
    }

    <section class="fb-card p-4">
        <dl class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div><dt class="fb-muted">Mã căn</dt><dd class="font-medium text-ink">@contract.PropertyCode</dd></div>
            <div><dt class="fb-muted">Phân khu</dt><dd class="font-medium text-ink">@contract.Area</dd></div>
            <div><dt class="fb-muted">Khách thuê</dt><dd class="font-medium text-ink">@contract.TenantName</dd></div>
            <div><dt class="fb-muted">Người phụ trách</dt><dd class="font-medium text-ink">@(contract.ManagerName ?? "Chưa có")</dd></div>
            <div><dt class="fb-muted">Giá thuê/tháng</dt><dd class="font-medium text-ink">@ContractDisplay.Money(contract.RentalPrice)</dd></div>
            <div><dt class="fb-muted">Tiền cọc</dt><dd class="font-medium text-ink">@ContractDisplay.Money(contract.DepositAmount)</dd></div>
            <div><dt class="fb-muted">Ngày ký</dt><dd class="font-medium text-ink">@ContractDisplay.DateText(contract.SignedDate)</dd></div>
            <div><dt class="fb-muted">Ngày hết hạn</dt><dd class="font-medium text-ink">@ContractDisplay.DateText(contract.ExpiryDate)</dd></div>
            <div><dt class="fb-muted">Thời hạn</dt><dd class="font-medium text-ink">@contract.TermMonths tháng</dd></div>
            <div><dt class="fb-muted">Trạng thái</dt><dd class="font-medium text-ink">@ContractDisplay.ContractStatusLabel(contract.Status)</dd></div>
            <div><dt class="fb-muted">Mã PE</dt><dd class="font-medium text-ink">@(contract.PeCode ?? "Chưa có")</dd></div>
            <div><dt class="fb-muted">Pass cửa</dt><dd class="font-medium text-ink">@(contract.PassCode ?? "Chưa có")</dd></div>
        </dl>
        @if (Model.CanDelete)
        {
            <form class="mt-4 flex flex-wrap items-end gap-2" method="post" action="/admin/tenant-contracts/@contract.Id/status">
                @Html.AntiForgeryToken()
                <label class="grid gap-1 text-sm">
                    <span class="fb-label">Đổi trạng thái</span>
                    <select class="fb-input" name="status">
                        @foreach (var item in ContractDisplay.ContractStatusOptions(contract.Status))
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                </label>
                <button class="fb-button fb-button-secondary" type="submit">Cập nhật</button>
            </form>
        }
        <div class="mt-4">
            <h3 class="font-semibold text-ink">Ghi chú</h3>
            <p class="mt-1 whitespace-pre-line text-sm text-ink">@(contract.Notes ?? "Chưa có")</p>
        </div>
    </section>
</div>
