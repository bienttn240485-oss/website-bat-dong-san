@model TenantContractListViewModel

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Hợp đồng khách thuê</h2>
            <p class="mt-1 text-sm text-muted">Theo dõi giá ra, tiền cọc, trạng thái và cảnh báo hết hạn.</p>
        </div>
        @if (Model.CanManage)
        {
            <a class="fb-button fb-button-primary" href="/admin/tenant-contracts/create">Thêm hợp đồng</a>
        }
    </div>

    <form class="fb-filter-panel grid gap-3 p-4 md:grid-cols-2 lg:grid-cols-4" method="get">
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Từ khóa</span>
            <input class="fb-input" asp-for="Filter.Keyword" name="Keyword" />
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Dự án</span>
            <select class="fb-input" asp-for="Filter.Project" asp-items="Model.ProjectOptions" name="Project"></select>
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Phân khu</span>
            <input class="fb-input" asp-for="Filter.Area" name="Area" />
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Trạng thái</span>
            <select class="fb-input" asp-for="Filter.Status" asp-items="Model.StatusOptions" name="Status">
                <option value="">Tất cả</option>
            </select>
        </label>
        <label class="flex min-h-11 items-center gap-2 text-sm font-medium text-ink">
            <input class="rounded border-line text-brand-700" asp-for="Filter.ExpiringSoon" name="ExpiringSoon" />
            <span>Hết hạn trong 30 ngày</span>
        </label>
        <label class="flex min-h-11 items-center gap-2 text-sm font-medium text-ink">
            <input class="rounded border-line text-brand-700" asp-for="Filter.ExpiredOnly" name="ExpiredOnly" />
            <span>Đã hết hạn</span>
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Sắp xếp</span>
            <select class="fb-input" asp-for="Filter.SortBy" name="SortBy">
                <option value="@ContractSortOptions.ExpiryDate">Ngày hết hạn</option>
                <option value="@ContractSortOptions.SignedDate">Ngày ký</option>
            </select>
        </label>
        <div class="flex items-end gap-2">
            <button class="fb-button fb-button-secondary" type="submit">Lọc</button>
            <a class="fb-button fb-button-ghost" href="/admin/tenant-contracts">Xóa lọc</a>
        </div>
    </form>

    @if (Model.Contracts.Count == 0)
    {
        <section class="fb-surface p-6 text-center">
            <h3 class="font-semibold text-ink">Chưa có hợp đồng khách thuê</h3>
            <p class="mt-1 text-sm text-muted">Tạo hợp đồng để đồng bộ trạng thái căn hộ và theo dõi giá ra.</p>
        </section>
    }
    else
    {
        <section class="fb-surface overflow-hidden">
            <div class="fb-table-wrap">
                <table class="fb-table min-w-[1180px]">
                    <thead>
                        <tr>
                            <th>Mã căn</th>
                            <th>Phân khu</th>
                            <th>Khách thuê</th>
                            <th>Phụ trách</th>
                            <th class="text-right">Giá thuê</th>
                            <th class="text-right">Tiền cọc</th>
                            <th>Ngày ký</th>
                            <th>Hết hạn</th>
                            <th>Thời hạn</th>
                            <th>Trạng thái</th>
                            <th>Mã PE</th>
                            <th>Cảnh báo</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var contract in Model.Contracts)
                        {
                            <tr>
                                <td class="font-semibold text-ink">@contract.PropertyCode</td>
                                <td>@contract.Area</td>
                                <td>@contract.TenantName</td>
                                <td>@(contract.ManagerName ?? "Chưa có")</td>
                                <td class="fb-money-cell">@ContractDisplay.Money(contract.RentalPrice)</td>
                                <td class="fb-money-cell">@ContractDisplay.Money(contract.DepositAmount)</td>
                                <td>@ContractDisplay.DateText(contract.SignedDate)</td>
                                <td>@ContractDisplay.DateText(contract.ExpiryDate)</td>
                                <td>@contract.TermMonths tháng</td>
                                <td>@ContractDisplay.ContractStatusLabel(contract.Status)</td>
                                <td>@(contract.PeCode ?? "Chưa có")</td>
                                <td>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var warning in contract.Warnings)
                                        {
                                            <span class="rounded-ui bg-amber-50 px-2 py-1 text-xs font-medium text-amber-800">@warning.Message</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="flex justify-end gap-2">
                                        <a class="fb-button fb-button-secondary min-h-9 px-3" href="/admin/tenant-contracts/@contract.Id">Xem</a>
                                        @if (Model.CanManage)
                                        {
                                            <a class="fb-button fb-button-secondary min-h-9 px-3" href="/admin/tenant-contracts/@contract.Id/edit">Sửa</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
