@model TenantContractFormViewModel

<form class="fb-surface grid gap-5 p-5" method="post">
    @Html.AntiForgeryToken()
    <partial name="_TenantContractForm" model="Model" />
    <div class="flex flex-wrap justify-end gap-2 border-t border-line pt-4">
        <a class="fb-button fb-button-secondary" href="/admin/tenant-contracts/@Model.Id">Hủy</a>
        <button class="fb-button fb-button-primary" type="submit">Lưu thay đổi</button>
    </div>
</form>
