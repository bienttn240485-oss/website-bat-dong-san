@model IReadOnlyList<StaffListItemViewModel>
@{
    ViewData["Title"] = "Nhân viên";
}

<section class="fb-surface p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-xl font-semibold text-ink">Nhân viên</h1>
            <p class="mt-1 text-sm text-muted">Admin quản lý tài khoản nội bộ của đội vận hành bất động sản.</p>
        </div>
        <a class="fb-button fb-button-primary justify-center" href="/admin/staff/create">Thêm nhân viên</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="mt-4">
            <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có nhân viên", "Thêm tài khoản nhân viên để phân quyền thao tác nội bộ.", IconName: "users")' />
        </div>
    }
    else
    {
        <div class="fb-table-wrap mt-4">
            <table class="fb-table min-w-[760px]">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line bg-white">
                    @foreach (var staff in Model)
                    {
                        var isActive = staff.AccountStatus == RealEstateManagement.Domain.Users.AccountStatus.Active;
                        <tr>
                            <td class="font-semibold text-ink">@staff.FullName</td>
                            <td class="text-muted">@staff.Email</td>
                            <td>
                                <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(staff.StatusLabel, staff.StatusTone)' />
                            </td>
                            <td class="text-muted">@staff.CreatedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</td>
                            <td class="text-right">
                                <div class="flex justify-end gap-2">
                                    <a class="fb-button fb-button-secondary min-h-9 px-3" href="/admin/staff/@staff.Id/edit">Sửa</a>
                                    <form method="post" action="/admin/staff/@staff.Id/toggle">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@(!isActive)" />
                                        <button class="fb-button @(isActive ? "fb-button-danger" : "fb-button-secondary") min-h-9 px-3" type="submit">
                                            @(isActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
