@using RealEstateManagement.Application.Common.Security

@{
    var isOwner = User.IsInRole(ApplicationRoles.Owner);
    var adminItems = new[]
    {
        new { Label = "Dashboard", Url = "/admin/dashboard", Icon = "home" },
        new { Label = "Căn hộ", Url = "/admin/properties", Icon = "building-office" },
        new { Label = "Hợp đồng chủ nhà", Url = "/admin/landlord-contracts", Icon = "clipboard-document-list" },
        new { Label = "Hợp đồng khách thuê", Url = "/admin/tenant-contracts", Icon = "clipboard-document-list" },
        new { Label = "Lead", Url = "/admin/leads", Icon = "users" },
        new { Label = "Nhân sự", Url = "/admin/staff", Icon = "users" },
        new { Label = "Hệ thống cũ: Lịch sân", Url = "/admin/schedule", Icon = "calendar" },
        new { Label = "Hệ thống cũ: Lịch đặt sân", Url = "/admin/bookings", Icon = "clipboard-document-list" },
        new { Label = "Hệ thống cũ: Thanh toán", Url = "/admin/payments", Icon = "credit-card" },
        new { Label = "Hệ thống cũ: Sân", Url = "/admin/fields", Icon = "building-office" },
        new { Label = "Hệ thống cũ: Dịch vụ", Url = "/admin/services", Icon = "clipboard-document-list" },
        new { Label = "Hệ thống cũ: Khuyến mãi", Url = "/admin/promotions", Icon = "tag" },
        new { Label = "Hệ thống cũ: Báo cáo", Url = "/admin/reports", Icon = "chart-bar" }
    };
    var saleItems = new[]
    {
        new { Label = "Dashboard", Url = "/admin/dashboard", Icon = "home" },
        new { Label = "Căn hộ", Url = "/admin/properties", Icon = "building-office" },
        new { Label = "Lead của tôi", Url = "/admin/leads", Icon = "users" },
        new { Label = "Hợp đồng chủ nhà", Url = "/admin/landlord-contracts", Icon = "clipboard-document-list" },
        new { Label = "Hợp đồng khách thuê", Url = "/admin/tenant-contracts", Icon = "clipboard-document-list" }
    };
    var items = isOwner ? adminItems : saleItems;
}

<aside class="hidden h-screen w-64 shrink-0 border-r border-line bg-white lg:sticky lg:top-0 lg:block">
    <div class="flex h-16 items-center border-b border-line px-4">
        <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" />
    </div>
    <nav class="grid gap-1 p-3 text-sm" aria-label="Điều hướng quản trị">
        @foreach (var item in items)
        {
            var isActive = Context.Request.Path.Value?.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase) == true;
            <a class="flex items-center gap-3 rounded-ui px-3 py-2 font-medium transition @(isActive ? "bg-brand-50 text-brand-800" : "text-muted hover:bg-slate-50 hover:text-ink")" href="@item.Url">
                <partial name="~/Views/Shared/Partials/_HeroIcon.cshtml" model="new HeroIconViewModel(item.Icon)" />
                <span>@item.Label</span>
            </a>
        }
    </nav>
</aside>

<div id="admin-mobile-sidebar" class="hs-overlay pointer-events-none fixed start-0 top-0 z-80 hidden size-full overflow-hidden lg:hidden" role="dialog" tabindex="-1" aria-label="Menu quản trị">
    <div class="hs-overlay-open:translate-x-0 pointer-events-auto h-full w-80 max-w-[88vw] -translate-x-full bg-white shadow-sm transition-transform">
        <div class="flex h-16 items-center justify-between border-b border-line px-4">
            <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" />
            <button class="fb-button fb-button-secondary px-3" type="button" aria-label="Đóng menu" data-hs-overlay="#admin-mobile-sidebar">
                <partial name="~/Views/Shared/Partials/_HeroIcon.cshtml" model='new HeroIconViewModel("x-mark")' />
            </button>
        </div>
        <nav class="grid gap-1 p-3 text-sm" aria-label="Điều hướng quản trị trên di động">
            @foreach (var item in items)
            {
                <a class="flex items-center gap-3 rounded-ui px-3 py-2 font-medium text-muted hover:bg-slate-50 hover:text-ink" href="@item.Url">
                    <partial name="~/Views/Shared/Partials/_HeroIcon.cshtml" model="new HeroIconViewModel(item.Icon)" />
                    <span>@item.Label</span>
                </a>
            }
        </nav>
    </div>
</div>

