@model AdminBookingListViewModel
@using RealEstateManagement.Domain.Bookings
@{
    ViewData["Title"] = "Lịch đặt sân";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
}

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-ink">Lịch đặt sân</h1>
            <p class="mt-1 text-sm text-muted">Theo dõi lượt đặt sân từ website vÃ  lượt đặt do nhân viên tạo.</p>
        </div>
        <a class="fb-button fb-button-primary" href="/admin/bookings/create">Tạo đặt sân</a>
    </div>

    <form class="fb-card grid gap-3 p-4 md:grid-cols-4" method="get">
        <div>
            <label class="fb-label" for="bookingDateText">NgÃ y</label>
            <input class="fb-input" id="bookingDateText" name="bookingDateText" value="@Model.BookingDateText" placeholder="dd/MM/yyyy" />
        </div>
        <div>
            <label class="fb-label" for="fieldId">Sân</label>
            <select class="fb-input" id="fieldId" name="fieldId">
                <option value="">Tất cả sân</option>
                @foreach (var field in Model.Fields)
                {
                    <option value="@field.Id" selected="@(Model.FieldId == field.Id)">@field.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="fb-label" for="status">Trạng thái</label>
            <select class="fb-input" id="status" name="status">
                <option value="">Tất cả trạng thái</option>
                @foreach (BookingStatus status in Enum.GetValues<BookingStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@BookingLabels.Status(status)</option>
                }
            </select>
        </div>
        <div class="flex items-end">
            <button class="fb-button fb-button-secondary w-full" type="submit">Lá»c danh sách</button>
        </div>
    </form>

    <section class="fb-card overflow-hidden">
        @if (Model.Bookings.Count == 0)
        {
            <div class="p-4">
                <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có lượt đặt sân", "Danh sách đặt sân sẽ hiển thị khi khách đặt sân hoặc nhân viên tạo lượt mới.", "Tạo đặt sân", "/admin/bookings/create", "clipboard-document-list")' />
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="fb-table">
                    <thead>
                        <tr>
                            <th>Mã đặt sân</th>
                            <th>Khách</th>
                            <th>Sân</th>
                            <th>NgÃ y giá»</th>
                            <th>Trạng thái</th>
                            <th>Tổng tiá»n</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td class="font-semibold">@booking.BookingCode</td>
                                <td><div class="font-medium">@booking.CustomerName</div><div class="text-xs text-muted">@booking.CustomerPhone</div></td>
                                <td>@booking.FieldName</td>
                                <td>@booking.BookingDate.ToString("dd/MM/yyyy") · @FormatMinute(booking.StartMinute) - @FormatMinute(booking.EndMinute)</td>
                                <td><partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(BookingLabels.Status(booking.Status), BookingLabels.StatusTone(booking.Status))' /></td>
                                <td>@FormatMoney(booking.TotalAmount)</td>
                                <td class="text-right"><a class="fb-button fb-button-secondary" href="/admin/bookings/@booking.Id">Xem</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

