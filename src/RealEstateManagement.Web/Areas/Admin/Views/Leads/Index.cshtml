@model LeadListViewModel
@using RealEstateManagement.Web.ViewModels.Shared

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Lead</h2>
            <p class="mt-1 text-sm text-muted">Theo dõi khách quan tâm và phân công tư vấn.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Thành công", success, "success")' />
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Không thể thực hiện", error, "danger")' />
    }

    <form class="fb-filter-panel grid gap-3 p-4" method="get" action="/admin/leads">
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <div>
                <label class="fb-label" asp-for="Filter.Keyword"></label>
                <input class="fb-input" asp-for="Filter.Keyword" name="Keyword" />
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Status"></label>
                <select class="fb-input" asp-for="Filter.Status" asp-items="Model.StatusOptions" name="Status">
                    <option value="">Tất cả</option>
                </select>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.AssignedToUserId"></label>
                <select class="fb-input" asp-for="Filter.AssignedToUserId" asp-items="Model.AssignedUserOptions" name="AssignedToUserId"></select>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.PropertyId"></label>
                <input class="fb-input" asp-for="Filter.PropertyId" name="PropertyId" />
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Project"></label>
                <select class="fb-input" asp-for="Filter.Project" asp-items="Model.ProjectOptions" name="Project"></select>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Area"></label>
                <input class="fb-input" asp-for="Filter.Area" name="Area" />
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Language"></label>
                <select class="fb-input" asp-for="Filter.Language" name="Language">
                    <option value="">Tất cả</option>
                    <option value="vi">Tiếng Việt</option>
                    <option value="en">English</option>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="fb-label" asp-for="Filter.CreatedFrom"></label>
                    <input class="fb-input" asp-for="Filter.CreatedFrom" name="CreatedFrom" type="date" />
                </div>
                <div>
                    <label class="fb-label" asp-for="Filter.CreatedTo"></label>
                    <input class="fb-input" asp-for="Filter.CreatedTo" name="CreatedTo" type="date" />
                </div>
            </div>
        </div>
        <label class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink">
            <input class="rounded border-line" asp-for="Filter.UnassignedOnly" name="UnassignedOnly" />
            <span>Chỉ xem Lead chưa phân công</span>
        </label>
        <div class="flex flex-wrap gap-2">
            <button class="fb-button fb-button-primary" type="submit">Lọc</button>
            <a class="fb-button fb-button-secondary" href="/admin/leads">Xóa lọc</a>
        </div>
    </form>

    <section class="fb-surface overflow-hidden">
        @if (Model.Leads.Count == 0)
        {
            <div class="py-10 text-center">
                <h3 class="font-semibold text-ink">Chưa có Lead phù hợp</h3>
                <p class="mt-2 text-sm text-muted">Lead mới từ form liên hệ sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="fb-table-wrap">
                <table class="fb-table min-w-[1120px]">
                    <thead>
                        <tr>
                            <th>Tên khách</th>
                            <th>Liên hệ</th>
                            <th>Property</th>
                            <th>Chủ đề</th>
                            <th>Ngôn ngữ</th>
                            <th>Trạng thái</th>
                            <th>Sale phụ trách</th>
                            <th>Ngày tạo</th>
                            <th>Ngày cập nhật</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var lead in Model.Leads)
                        {
                            <tr>
                                <td class="font-semibold text-ink">@lead.Name</td>
                                <td>@lead.Contact</td>
                                <td>@(lead.PropertyCode is null ? "Chưa gắn" : $"{lead.PropertyCode} - {lead.PropertyArea}")</td>
                                <td>@(lead.Subject ?? "Chưa có")</td>
                                <td>@lead.Language</td>
                                <td>
                                    <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(lead.StatusLabel, lead.StatusTone)' />
                                </td>
                                <td>@(lead.AssignedToDisplayName ?? "Chưa phân công")</td>
                                <td>@LeadDisplay.DateTimeText(lead.CreatedAtUtc)</td>
                                <td>@LeadDisplay.DateTimeText(lead.UpdatedAtUtc)</td>
                                <td class="text-right">
                                    <a class="fb-button fb-button-secondary min-h-9 px-3" href="/admin/leads/@lead.Id">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
