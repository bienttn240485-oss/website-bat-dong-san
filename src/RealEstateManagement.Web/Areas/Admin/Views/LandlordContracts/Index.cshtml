@model LandlordContractListViewModel

<div class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Hợp đồng chủ nhà</h2>
            <p class="mt-1 text-sm text-muted">Theo dõi giá vào, kỳ thanh toán và cảnh báo hết hạn.</p>
        </div>
        @if (Model.CanManage)
        {
            <a class="fb-button fb-button-primary" href="/admin/landlord-contracts/create">Thêm hợp đồng</a>
        }
    </div>

    <form class="fb-card grid gap-3 p-4 md:grid-cols-4" method="get">
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Từ khóa</span>
            <input class="fb-input" asp-for="Filter.Keyword" name="Keyword" />
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Dự án</span>
            <select class="fb-input" asp-for="Filter.Project" asp-items="Model.ProjectOptions" name="Project"></select>
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Phân khu</span>
            <input class="fb-input" asp-for="Filter.Area" name="Area" />
        </label>
        <label class="grid gap-1 text-sm">
            <span class="fb-label">Trạng thái cọc</span>
            <select class="fb-input" asp-for="Filter.DepositStatus" asp-items="Model.DepositStatusOptions" name="DepositStatus">
                <option value="">Tất cả</option>
            </select>
        </label>
        <label class="flex items-center gap-2 text-sm">
            <input class="rounded border-line text-brand-700" asp-for="Filter.ExpiringSoon" name="ExpiringSoon" />
            <span>Hết hạn trong 30 ngày</span>
        </label>
        <label class="flex items-center gap-2 text-sm">
            <input class="rounded border-line text-brand-700" asp-for="Filter.ExpiredOnly" name="ExpiredOnly" />
            <span>Đã hết hạn</span>
        </label>
        <div class="flex items-end gap-2 md:col-span-2">
            <button class="fb-button fb-button-secondary" type="submit">Lọc</button>
            <a class="fb-button fb-button-ghost" href="/admin/landlord-contracts">Xóa lọc</a>
        </div>
    </form>

    @if (Model.Contracts.Count == 0)
    {
        <section class="fb-card p-6 text-center">
            <h3 class="font-semibold text-ink">Chưa có hợp đồng chủ nhà</h3>
            <p class="mt-1 text-sm text-muted">Tạo hợp đồng đầu tiên để theo dõi giá vào và kỳ thanh toán.</p>
        </section>
    }
    else
    {
        <section class="fb-card overflow-x-auto">
            <table class="min-w-[980px] w-full text-left text-sm">
                <thead class="border-b border-line bg-slate-50 text-xs uppercase text-muted">
                    <tr>
                        <th class="px-4 py-3">Mã căn</th>
                        <th class="px-4 py-3">Phân khu</th>
                        <th class="px-4 py-3">Chủ nhà</th>
                        <th class="px-4 py-3">Sale</th>
                        <th class="px-4 py-3">Mã PE</th>
                        <th class="px-4 py-3">Giá nhập</th>
                        <th class="px-4 py-3">Ngày ký</th>
                        <th class="px-4 py-3">Hết hạn</th>
                        <th class="px-4 py-3">Cọc</th>
                        <th class="px-4 py-3">Thanh toán</th>
                        <th class="px-4 py-3">Cảnh báo</th>
                        <th class="px-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var contract in Model.Contracts)
                    {
                        <tr>
                            <td class="px-4 py-3 font-semibold text-ink">@contract.PropertyCode</td>
                            <td class="px-4 py-3">@contract.Area</td>
                            <td class="px-4 py-3">@contract.LandlordName</td>
                            <td class="px-4 py-3">@(contract.SaleName ?? "Chưa có")</td>
                            <td class="px-4 py-3">@(contract.PeCode ?? "Chưa có")</td>
                            <td class="px-4 py-3">@ContractDisplay.Money(contract.InputPrice)</td>
                            <td class="px-4 py-3">@ContractDisplay.DateText(contract.SignedDate)</td>
                            <td class="px-4 py-3">@ContractDisplay.DateText(contract.ExpiryDate)</td>
                            <td class="px-4 py-3">@ContractDisplay.DepositStatusLabel(contract.DepositStatus)</td>
                            <td class="px-4 py-3">@(contract.PaymentDay?.ToString() ?? "Chưa có")</td>
                            <td class="px-4 py-3">
                                @foreach (var warning in contract.Warnings)
                                {
                                    <span class="rounded-ui bg-amber-50 px-2 py-1 text-xs text-amber-800">@warning.Message</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-wrap gap-2">
                                    <a class="fb-button fb-button-secondary px-3 py-1 text-xs" href="/admin/landlord-contracts/@contract.Id">Xem</a>
                                    @if (Model.CanManage)
                                    {
                                        <a class="fb-button fb-button-secondary px-3 py-1 text-xs" href="/admin/landlord-contracts/@contract.Id/edit">Sửa</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>
