@model LandlordContractFormViewModel

<form class="fb-card grid gap-5 p-5" method="post">
    @Html.AntiForgeryToken()
    <partial name="_LandlordContractForm" model="Model" />
    <div class="flex flex-wrap gap-2">
        <button class="fb-button fb-button-primary" type="submit">Lưu thay đổi</button>
        <a class="fb-button fb-button-secondary" href="/admin/landlord-contracts/@Model.Id">Hủy</a>
    </div>
</form>
