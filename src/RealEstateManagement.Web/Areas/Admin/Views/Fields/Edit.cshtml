@model FieldFormViewModel
@using RealEstateManagement.Domain.Fields

@functions {
    private static string TimeValue(int? minute) => minute is null ? string.Empty : $"{minute.Value / 60:00}:{minute.Value % 60:00}";
    private static string DateValue(DateOnly? date) => date?.ToString("yyyy-MM-dd") ?? string.Empty;
    private static string DayName(int day) => day switch
    {
        0 => "Chủ nhật",
        1 => "Thứ hai",
        2 => "Thứ ba",
        3 => "Thứ tư",
        4 => "Thứ năm",
        5 => "Thứ sáu",
        6 => "Thứ bảy",
        _ => "Không rõ"
    };
}

<form class="space-y-5" method="post">
    @Html.AntiForgeryToken()
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">@ViewData["Title"]</h2>
            <p class="mt-1 text-sm text-muted">Cập nhật dữ liệu sân, giá» hoạt động vÃ  bảng giá. Chưa triển khai upload ảnh trong lát nÃ y.</p>
        </div>
        <div class="flex gap-2">
            <a class="fb-button fb-button-secondary" href="/admin/fields">Hủy</a>
            <button class="fb-button fb-button-primary" type="submit">Lưu sân</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"></div>

    <section class="fb-card p-4">
        <h3 class="font-semibold text-ink">Thông tin cơ bản</h3>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
            <div><label asp-for="Code" class="fb-label"></label><input asp-for="Code" class="fb-input" /><span asp-validation-for="Code" class="text-xs text-red-700"></span></div>
            <div><label asp-for="Name" class="fb-label"></label><input asp-for="Name" class="fb-input" /><span asp-validation-for="Name" class="text-xs text-red-700"></span></div>
            <div><label asp-for="Slug" class="fb-label"></label><input asp-for="Slug" class="fb-input" /><span asp-validation-for="Slug" class="text-xs text-red-700"></span></div>
            <div><label asp-for="FieldType" class="fb-label"></label><input asp-for="FieldType" class="fb-input" /></div>
            <div><label asp-for="Capacity" class="fb-label"></label><input asp-for="Capacity" class="fb-input" type="number" min="1" /></div>
            <div>
                <label asp-for="Status" class="fb-label"></label>
                <select asp-for="Status" class="fb-input">
                    <option value="Active">Äang hoạt động</option>
                    <option value="TemporarilyClosed">Tạm đóng</option>
                    <option value="Maintenance">Bảo trì</option>
                    <option value="Inactive">Ngừng khai thác</option>
                </select>
            </div>
            <div><label asp-for="MinimumBookingMinutes" class="fb-label"></label><input asp-for="MinimumBookingMinutes" class="fb-input" type="number" min="1" /></div>
            <div><label asp-for="SlotStepMinutes" class="fb-label"></label><input asp-for="SlotStepMinutes" class="fb-input" type="number" min="1" /></div>
            <div class="md:col-span-2"><label asp-for="Address" class="fb-label"></label><input asp-for="Address" class="fb-input" /></div>
            <div class="md:col-span-2"><label asp-for="AmenitiesText" class="fb-label"></label><input asp-for="AmenitiesText" class="fb-input" /><p class="mt-1 text-xs text-muted">Nhập các tiện ích, phân tách bằng dấu phẩy.</p></div>
            <div class="md:col-span-2"><label asp-for="Description" class="fb-label"></label><textarea asp-for="Description" class="fb-input" rows="4"></textarea></div>
        </div>
    </section>

    <section class="fb-card p-4">
        <h3 class="font-semibold text-ink">Ảnh sân</h3>
        @for (var i = 0; i < Model.Images.Count; i++)
        {
            <div class="mt-4 grid gap-4 md:grid-cols-[1fr_1fr_120px_120px]">
                <div><label class="fb-label" for="Images_@(i)__StoragePath">ÄÆ°á»ng dẫn ảnh</label><input class="fb-input" id="Images_@(i)__StoragePath" name="Images[@i].StoragePath" value="@Model.Images[i].StoragePath" /></div>
                <div><label class="fb-label" for="Images_@(i)__AltText">Mô tả ảnh</label><input class="fb-input" id="Images_@(i)__AltText" name="Images[@i].AltText" value="@Model.Images[i].AltText" /></div>
                <div><label class="fb-label" for="Images_@(i)__SortOrder">Thứ tự</label><input class="fb-input" id="Images_@(i)__SortOrder" name="Images[@i].SortOrder" type="number" value="@Model.Images[i].SortOrder" /></div>
                <label class="mt-7 flex items-center gap-2 text-sm"><input class="rounded border-line text-brand-700" name="Images[@i].IsCover" type="checkbox" value="true" checked="@Model.Images[i].IsCover" /><input name="Images[@i].IsCover" type="hidden" value="false" />Ảnh đại diện</label>
            </div>
        }
    </section>

    <section class="fb-card p-4">
        <h3 class="font-semibold text-ink">Giá» hoạt động</h3>
        <div class="mt-4 grid gap-3">
            @for (var i = 0; i < Model.OperatingHours.Count; i++)
            {
                <div class="grid gap-3 rounded-ui border border-line p-3 md:grid-cols-[1fr_120px_160px_160px] md:items-center">
                    <input name="OperatingHours[@i].DayOfWeek" type="hidden" value="@Model.OperatingHours[i].DayOfWeek" />
                    <span class="font-medium text-ink">@DayName(Model.OperatingHours[i].DayOfWeek)</span>
                    <label class="flex items-center gap-2 text-sm"><input class="rounded border-line text-brand-700" name="OperatingHours[@i].IsClosed" type="checkbox" value="true" checked="@Model.OperatingHours[i].IsClosed" /><input name="OperatingHours[@i].IsClosed" type="hidden" value="false" />ÄÃ³ng cửa</label>
                    <div><label class="fb-label" for="OperatingHours_@(i)__OpenMinute">Mở cửa</label><input class="fb-input" id="OperatingHours_@(i)__OpenMinute" name="OperatingHours[@i].OpenMinute" type="number" min="0" max="1440" value="@Model.OperatingHours[i].OpenMinute" /></div>
                    <div><label class="fb-label" for="OperatingHours_@(i)__CloseMinute">ÄÃ³ng cửa lúc</label><input class="fb-input" id="OperatingHours_@(i)__CloseMinute" name="OperatingHours[@i].CloseMinute" type="number" min="0" max="1440" value="@Model.OperatingHours[i].CloseMinute" /></div>
                </div>
            }
        </div>
    </section>

    <section class="fb-card p-4">
        <h3 class="font-semibold text-ink">Bảng giá</h3>
        <div class="mt-4 grid gap-3">
            @for (var i = 0; i < Model.PricingRules.Count; i++)
            {
                <div class="grid gap-3 rounded-ui border border-line p-3 lg:grid-cols-4">
                    <div><label class="fb-label">Tên giá</label><input class="fb-input" name="PricingRules[@i].Name" value="@Model.PricingRules[i].Name" /></div>
                    <div>
                        <label class="fb-label">Loại giá</label>
                        <select class="fb-input" name="PricingRules[@i].RuleType">
                            <option value="Weekday" selected="@(Model.PricingRules[i].RuleType == PricingRuleType.Weekday)">NgÃ y thÆ°á»ng</option>
                            <option value="Weekend" selected="@(Model.PricingRules[i].RuleType == PricingRuleType.Weekend)">Cuối tuần</option>
                            <option value="SpecificDate" selected="@(Model.PricingRules[i].RuleType == PricingRuleType.SpecificDate)">NgÃ y cụ thể</option>
                            <option value="SpecialRange" selected="@(Model.PricingRules[i].RuleType == PricingRuleType.SpecialRange)">Khoảng đặc biệt</option>
                        </select>
                    </div>
                    <div><label class="fb-label">Bắt đầu hiệu lực</label><input class="fb-input" name="PricingRules[@i].EffectiveFrom" type="date" value="@DateValue(Model.PricingRules[i].EffectiveFrom)" /></div>
                    <div><label class="fb-label">Kết thúc</label><input class="fb-input" name="PricingRules[@i].EffectiveTo" type="date" value="@DateValue(Model.PricingRules[i].EffectiveTo)" /></div>
                    <div><label class="fb-label">Từ phút</label><input class="fb-input" name="PricingRules[@i].StartMinute" type="number" value="@Model.PricingRules[i].StartMinute" /></div>
                    <div><label class="fb-label">Äáº¿n phút</label><input class="fb-input" name="PricingRules[@i].EndMinute" type="number" value="@Model.PricingRules[i].EndMinute" /></div>
                    <div><label class="fb-label">Giá mỗi giá»</label><input class="fb-input" name="PricingRules[@i].PricePerHour" type="number" value="@Model.PricingRules[i].PricePerHour" /></div>
                    <div><label class="fb-label">Ưu tiên</label><input class="fb-input" name="PricingRules[@i].Priority" type="number" value="@Model.PricingRules[i].Priority" /></div>
                    <input name="PricingRules[@i].IsActive" type="hidden" value="true" />
                </div>
            }
        </div>
    </section>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

