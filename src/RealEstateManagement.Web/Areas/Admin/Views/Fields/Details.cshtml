@model RealEstateManagement.Application.Fields.FieldDetailDto
@using RealEstateManagement.Domain.Fields
@{
    var blockForm = ViewData["BlockForm"] as FieldBlockFormViewModel ?? new FieldBlockFormViewModel { FieldId = Model.Id };
}

@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} â‚«/giá»", amount).Replace(",", ".");
    private static string FormatMinute(int? minute) => minute is null ? "--:--" : $"{minute.Value / 60:00}:{minute.Value % 60:00}";
    private static string FormatDate(DateOnly date) => date.ToString("dd/MM/yyyy");
    private static string DayName(int day) => day switch
    {
        0 => "Chủ nhật",
        1 => "Thứ hai",
        2 => "Thứ ba",
        3 => "Thứ tư",
        4 => "Thứ năm",
        5 => "Thứ sáu",
        6 => "Thứ bảy",
        _ => "Không rõ"
    };
    private static string BlockTypeLabel(FieldBlockType type) => type switch
    {
        FieldBlockType.Maintenance => "Bảo trì",
        FieldBlockType.InternalEvent => "Sự kiện nội bộ",
        FieldBlockType.Weather => "Thá»i tiết",
        FieldBlockType.TechnicalIssue => "Sự cố kỹ thuật",
        FieldBlockType.BusinessClosure => "ÄÃ³ng cửa",
        _ => "Khác"
    };
    private static string StatusLabel(FieldStatus status) => status switch
    {
        FieldStatus.Active => "Äang hoạt động",
        FieldStatus.TemporarilyClosed => "Tạm đóng",
        FieldStatus.Maintenance => "Bảo trì",
        FieldStatus.Inactive => "Ngừng khai thác",
        _ => "Không xác định"
    };
}

<div class="space-y-5">
    @if (TempData["SuccessMessage"] is string success)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("ThÃ nh công", success, "success")' />
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Chưa lưu được", error, "danger")' />
    }

    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">@Model.Name</h2>
            <p class="mt-1 text-sm text-muted">@Model.Code · @Model.FieldType · @StatusLabel(Model.Status)</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="fb-button fb-button-primary" href="/admin/fields/@Model.Id/edit">Cập nhật sân</a>
        </div>
    </div>

    <section class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
        <img class="fb-card aspect-[16/9] w-full object-cover" src="@(Model.Images.FirstOrDefault(image => image.IsCover)?.StoragePath ?? "/images/fields/san-5a.svg")" alt="@Model.Name" />
        <div class="fb-card p-4">
            <h3 class="font-semibold text-ink">Thông tin vận hÃ nh</h3>
            <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
                <div><dt class="text-muted">Äá»‹a chỉ</dt><dd class="mt-1 font-medium text-ink">@Model.Address</dd></div>
                <div><dt class="text-muted">Sức chứa</dt><dd class="mt-1 font-medium text-ink">@Model.Capacity ngÆ°á»i</dd></div>
                <div><dt class="text-muted">Äáº·t tối thiểu</dt><dd class="mt-1 font-medium text-ink">@Model.MinimumBookingMinutes phút</dd></div>
                <div><dt class="text-muted">Bước khung giá»</dt><dd class="mt-1 font-medium text-ink">@Model.SlotStepMinutes phút</dd></div>
            </dl>
            <p class="mt-4 text-sm leading-6 text-muted">@Model.Description</p>
            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var amenity in Model.Amenities)
                {
                    <span class="rounded-ui border border-line bg-slate-50 px-2 py-1 text-xs text-muted">@amenity</span>
                }
            </div>
        </div>
    </section>

    <section class="grid gap-5 xl:grid-cols-2">
        <div class="fb-card overflow-hidden">
            <div class="border-b border-line px-4 py-3"><h3 class="font-semibold text-ink">Giá» hoạt động</h3></div>
            <div class="grid divide-y divide-line">
                @foreach (var hour in Model.OperatingHours)
                {
                    <div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                        <span class="font-medium">@DayName(hour.DayOfWeek)</span>
                        <span class="text-muted">@(hour.IsClosed ? "ÄÃ³ng cửa" : $"{FormatMinute(hour.OpenMinute)} - {FormatMinute(hour.CloseMinute)}")</span>
                    </div>
                }
            </div>
        </div>

        <div class="fb-card overflow-hidden">
            <div class="border-b border-line px-4 py-3"><h3 class="font-semibold text-ink">Bảng giá</h3></div>
            <div class="overflow-x-auto">
                <table class="fb-table">
                    <thead><tr><th>Tên giá</th><th>Khung giá»</th><th>GiÃ¡</th></tr></thead>
                    <tbody class="divide-y divide-line bg-white">
                        @foreach (var rule in Model.PricingRules)
                        {
                            <tr>
                                <td>@rule.Name</td>
                                <td>@FormatMinute(rule.StartMinute) - @FormatMinute(rule.EndMinute)</td>
                                <td>@FormatMoney(rule.PricePerHour)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="grid gap-5 xl:grid-cols-[1fr_0.8fr]">
        <div class="fb-card overflow-hidden">
            <div class="border-b border-line px-4 py-3"><h3 class="font-semibold text-ink">Lịch khóa sân</h3></div>
            @if (Model.Blocks.Count == 0)
            {
                <div class="p-4">
                    <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có lịch khóa sân", "Các lịch bảo trì hoặc tạm đóng sân sẽ hiển thị tại đây.")' />
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="fb-table">
                        <thead><tr><th>NgÃ y</th><th>Khung giá»</th><th>Loáº¡i</th><th>LÃ½ do</th></tr></thead>
                        <tbody class="divide-y divide-line bg-white">
                            @foreach (var block in Model.Blocks)
                            {
                                <tr>
                                    <td>@FormatDate(block.BlockDate)</td>
                                    <td>@FormatMinute(block.StartMinute) - @FormatMinute(block.EndMinute)</td>
                                    <td>@BlockTypeLabel(block.BlockType)</td>
                                    <td>@block.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <form class="fb-card p-4" method="post" action="/admin/fields/@Model.Id/blocks">
            @Html.AntiForgeryToken()
            <h3 class="font-semibold text-ink">Thêm lịch khóa sân</h3>
            <div class="mt-4 grid gap-3">
                <div><label class="fb-label" for="BlockDateText">NgÃ y khóa</label><input class="fb-input" id="BlockDateText" name="BlockDateText" type="text" inputmode="numeric" placeholder="dd/MM/yyyy" value="@blockForm.BlockDateText" /></div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="fb-label" for="StartMinute">Từ phút</label><input class="fb-input" id="StartMinute" name="StartMinute" type="number" value="@blockForm.StartMinute" /></div>
                    <div><label class="fb-label" for="EndMinute">Äáº¿n phút</label><input class="fb-input" id="EndMinute" name="EndMinute" type="number" value="@blockForm.EndMinute" /></div>
                </div>
                <div>
                    <label class="fb-label" for="BlockType">Loại khóa sân</label>
                    <select class="fb-input" id="BlockType" name="BlockType">
                        <option value="Maintenance">Bảo trì</option>
                        <option value="InternalEvent">Sự kiện nội bộ</option>
                        <option value="Weather">Thá»i tiết</option>
                        <option value="TechnicalIssue">Sự cố kỹ thuật</option>
                        <option value="BusinessClosure">ÄÃ³ng cửa</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>
                <div><label class="fb-label" for="Reason">Lý do</label><textarea class="fb-input" id="Reason" name="Reason" rows="3"></textarea></div>
                <button class="fb-button fb-button-primary" type="submit">Lưu lịch khóa sân</button>
            </div>
        </form>
    </section>
</div>
