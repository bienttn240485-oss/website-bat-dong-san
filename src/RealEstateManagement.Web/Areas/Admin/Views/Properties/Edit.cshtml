@model PropertyFormViewModel

<form class="space-y-5" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Cập nhật @Model.Code</h2>
            <p class="mt-1 text-sm text-muted">Điều chỉnh thông tin căn hộ, ảnh URL, nội thất và tiện ích.</p>
        </div>
        <div class="flex gap-2">
            <a class="fb-button fb-button-secondary" href="@(Model.Id is Guid id ? $"/admin/properties/{id}" : "/admin/properties")">Hủy</a>
            <button class="fb-button fb-button-primary" type="submit">Lưu thay đổi</button>
        </div>
    </div>

    <partial name="_PropertyForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
