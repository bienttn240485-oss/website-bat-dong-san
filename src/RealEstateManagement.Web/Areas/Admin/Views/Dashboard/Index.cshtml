@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard bất động sản";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItemViewModel>
    {
        new("Quản trị", "/admin/dashboard"),
        new("Dashboard")
    };
}

<div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Vận hành bất động sản</p>
            <h1 class="mt-1 text-2xl font-semibold text-ink">Dashboard</h1>
            <p class="mt-1 text-sm text-muted">Số liệu được tổng hợp trực tiếp từ căn hộ, hợp đồng và lead trong database.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="fb-button fb-button-secondary" href="/admin/properties">Căn hộ</a>
            <a class="fb-button fb-button-secondary" href="/admin/tenant-contracts">Hợp đồng thuê</a>
            <a class="fb-button fb-button-primary" href="/admin/leads">Lead</a>
        </div>
    </div>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        @foreach (var metric in Model.Metrics)
        {
            <article class="fb-card min-w-0 p-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-sm font-medium text-muted">@metric.Label</p>
                        <p class="mt-2 text-2xl font-semibold text-ink">@metric.Value</p>
                    </div>
                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold @BadgeClass(metric.Tone)">@(ToneLabel(metric.Tone))</span>
                </div>
                <p class="mt-3 text-sm text-muted">@metric.Note</p>
            </article>
        }
    </section>

    @if (Model.CanViewFinancials)
    {
        <section class="fb-card p-4">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="font-semibold text-ink">Tài chính vận hành</h2>
                    <p class="text-sm text-muted">Giá vào, giá ra và chênh lệch tính từ hợp đồng hiện có.</p>
                </div>
            </div>
            <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">Tổng giá vào/tháng</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.MonthlyInputTotal</p>
                </div>
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">Tổng giá ra/tháng</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.MonthlyRentTotal</p>
                </div>
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">Chênh lệch/tháng</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.MonthlySpread</p>
                </div>
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">Căn có chênh lệch âm</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.NegativeMarginProperties</p>
                </div>
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">Chênh lệch trung bình/tháng</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.AverageMonthlySpread</p>
                </div>
                <div class="rounded-ui border border-line bg-surface-muted p-3">
                    <p class="text-sm text-muted">GMV thuê 12 tháng</p>
                    <p class="mt-1 text-lg font-semibold text-ink">@Model.Financial.TenantContractGmvLast12Months</p>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="fb-card p-4">
            <h2 class="font-semibold text-ink">Tài chính vận hành</h2>
            <p class="mt-1 text-sm text-muted">Tài khoản hiện tại không có quyền xem số liệu tài chính nhạy cảm.</p>
        </section>
    }

    <section class="grid gap-5 xl:grid-cols-2">
        @foreach (var chart in Model.Charts.Where(chart => Model.CanViewFinancials || !chart.IsFinancial))
        {
            <article class="fb-card min-w-0 p-4">
                <div>
                    <h2 class="font-semibold text-ink">@chart.Title</h2>
                    <p class="text-sm text-muted">@chart.Description</p>
                </div>
                <div class="mt-4 h-72 min-w-0">
                    <canvas data-report-chart data-chart-url="@ChartUrl(chart.Id)" aria-label="@chart.AriaLabel"></canvas>
                </div>
                <p class="mt-3 hidden rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-chart-error>Không tải được dữ liệu biểu đồ.</p>
            </article>
        }
    </section>

    <section class="grid gap-5 xl:grid-cols-[1.05fr_0.95fr]">
        <article class="fb-card min-w-0 overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Cảnh báo cần xử lý</h2>
                <p class="text-sm text-muted">Hợp đồng, trạng thái căn hộ và lead cần theo dõi.</p>
            </div>
            @if (Model.Warnings.Count == 0)
            {
                <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Không có cảnh báo", "Dữ liệu vận hành hiện không có điểm bất thường cần xử lý.")' />
            }
            else
            {
                <div class="divide-y divide-line">
                    @foreach (var warning in Model.Warnings.Take(12))
                    {
                        <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-start sm:justify-between">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold @BadgeClass(warning.Tone)">@(ToneLabel(warning.Tone))</span>
                                    <h3 class="font-medium text-ink">@warning.Title</h3>
                                </div>
                                <p class="mt-1 text-sm text-muted">@warning.Description</p>
                            </div>
                            @if (warning.Link is not null)
                            {
                                <a class="text-sm font-semibold text-brand-800 hover:text-brand-900" href="@warning.Link">Mở</a>
                            }
                        </div>
                    }
                </div>
            }
        </article>

        <article class="fb-card min-w-0 overflow-hidden">
            <div class="border-b border-line px-4 py-3">
                <h2 class="font-semibold text-ink">Timeline 12 tháng tới</h2>
                <p class="text-sm text-muted">Ngày hết hạn, ngày trống và hoàn cọc sắp tới.</p>
            </div>
            @if (Model.Timeline.Count == 0)
            {
                <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có mốc thời gian", "Các sự kiện hợp đồng và ngày trống sẽ hiển thị tại đây.")' />
            }
            else
            {
                <div class="divide-y divide-line">
                    @foreach (var item in Model.Timeline.Take(14))
                    {
                        <div class="flex items-start justify-between gap-3 px-4 py-3">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold @BadgeClass(item.Tone)">@item.EventType</span>
                                    <span class="font-semibold text-ink">@item.PropertyCode</span>
                                </div>
                                <p class="mt-1 text-sm text-muted">@item.Description</p>
                            </div>
                            <div class="shrink-0 text-right">
                                <p class="text-sm font-semibold text-ink">@item.DateText</p>
                                <a class="text-sm font-medium text-brand-800 hover:text-brand-900" href="@item.Link">Chi tiết</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>
</div>

@section Scripts {
    <script src="~/js/admin-reports.js" asp-append-version="true"></script>
}

@functions {
    private static string BadgeClass(string tone)
        => tone switch
        {
            "success" => "bg-emerald-50 text-emerald-700",
            "active" => "bg-teal-50 text-teal-700",
            "warning" => "bg-amber-50 text-amber-700",
            "danger" => "bg-red-50 text-red-700",
            _ => "bg-sky-50 text-sky-700"
        };

    private static string ToneLabel(string tone)
        => tone switch
        {
            "success" => "Tốt",
            "active" => "Đang chạy",
            "warning" => "Cần chú ý",
            "danger" => "Rủi ro",
            _ => "Thông tin"
        };

    private static string ChartUrl(string id)
        => id switch
        {
            "gmv-chart" => "/admin/api/dashboard/gmv",
            "contracts-chart" => "/admin/api/dashboard/contracts",
            "property-status-chart" => "/admin/api/dashboard/property-status",
            "lead-status-chart" => "/admin/api/dashboard/lead-status",
            _ => "/admin/api/dashboard/property-status"
        };
}
