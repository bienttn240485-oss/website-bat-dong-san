@model IReadOnlyList<RealEstateManagement.Application.Reports.ReportBookingRecordDto>
@using RealEstateManagement.Application.Bookings

@if (Model.Count == 0)
{
    <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có lượt đặt sân", "Dữ liệu sẽ hiển thị khi có lượt đặt sân phù hợp bộ lá»c.")' />
}
else
{
    <div class="overflow-x-auto">
        <table class="fb-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Khách</th>
                    <th>Sân</th>
                    <th>NgÃ y giá»</th>
                    <th>Trạng thái</th>
                    <th>Còn thu</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line bg-white">
                @foreach (var booking in Model)
                {
                    <tr>
                        <td><a class="font-semibold text-brand-800 hover:text-brand-900" href="/admin/bookings/@booking.Id">@booking.BookingCode</a></td>
                        <td>@booking.CustomerName</td>
                        <td>@booking.FieldName</td>
                        <td>@booking.BookingDate.ToString("dd/MM/yyyy") · @FormatMinute(booking.StartMinute) - @FormatMinute(booking.EndMinute)</td>
                        <td><partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(BookingLabels.Status(booking.Status), BookingLabels.StatusTone(booking.Status))' /></td>
                        <td class="font-medium text-ink">@FormatMoney(Math.Max(0, booking.TotalAmount - booking.PaidAmount + booking.RefundedAmount))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    private static string FormatMinute(int minute) => $"{minute / 60:00}:{minute % 60:00}";
    private static string FormatMoney(long amount) => amount.ToString("N0").Replace(",", ".") + " ₫";
}

