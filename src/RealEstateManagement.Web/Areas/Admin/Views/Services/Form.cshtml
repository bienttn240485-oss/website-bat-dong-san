@model ServiceFormViewModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Cập nhật dịch vụ" : "Thêm dịch vụ";
}

<section class="fb-card p-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h1 class="text-xl font-semibold text-ink">@(isEdit ? "Cập nhật dịch vụ" : "Thêm dịch vụ")</h1>
            <p class="mt-1 text-sm text-muted">Dịch vụ được dùng trong luồng đặt sân và được lưu snapshot vào từng lượt đặt.</p>
        </div>
        <a class="fb-button fb-button-secondary justify-center" href="/admin/services">Quay lại</a>
    </div>

    <form class="mt-5 grid gap-4" method="post" action="@(isEdit ? $"/admin/services/{Model.Id}/edit" : "/admin/services/create")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="fb-label" asp-for="Code"></label>
                <input class="fb-input" asp-for="Code" placeholder="Để trống để hệ thống tự tạo" />
                <span class="text-xs text-red-700" asp-validation-for="Code"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="Name"></label>
                <input class="fb-input" asp-for="Name" />
                <span class="text-xs text-red-700" asp-validation-for="Name"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="UnitName"></label>
                <input class="fb-input" asp-for="UnitName" placeholder="quả, bộ, chai, trận" />
                <span class="text-xs text-red-700" asp-validation-for="UnitName"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="UnitPrice"></label>
                <input class="fb-input" asp-for="UnitPrice" type="number" min="0" step="1000" />
                <span class="text-xs text-red-700" asp-validation-for="UnitPrice"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="AvailableQuantity"></label>
                <input class="fb-input" asp-for="AvailableQuantity" type="number" min="0" />
                <span class="text-xs text-red-700" asp-validation-for="AvailableQuantity"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="SortOrder"></label>
                <input class="fb-input" asp-for="SortOrder" type="number" />
            </div>
        </div>
        <div>
            <label class="fb-label" asp-for="Description"></label>
            <textarea class="fb-input" asp-for="Description" rows="3"></textarea>
            <span class="text-xs text-red-700" asp-validation-for="Description"></span>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
            <label class="flex items-center gap-2 rounded-ui border border-line px-3 py-2 text-sm text-ink">
                <input class="rounded border-line text-brand-700 focus:ring-brand-700" asp-for="IsQuantityTracked" />
                <span>Theo dõi số lượng khả dụng</span>
            </label>
            <label class="flex items-center gap-2 rounded-ui border border-line px-3 py-2 text-sm text-ink">
                <input class="rounded border-line text-brand-700 focus:ring-brand-700" asp-for="IsActive" />
                <span>Đang sử dụng</span>
            </label>
        </div>
        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <a class="fb-button fb-button-secondary justify-center" href="/admin/services">Hủy</a>
            <button class="fb-button fb-button-primary justify-center" type="submit">Lưu dịch vụ</button>
        </div>
    </form>
</section>
