@model RealEstateManagement.Web.ViewModels.PublicContactViewModel
@using RealEstateManagement.Web.ViewModels.Shared

@{
    ViewData["Title"] = "Liên hệ tư vấn";
}

<section class="border-b border-line bg-white">
    <div class="fb-container grid gap-6 py-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div>
            <p class="text-sm font-semibold uppercase text-brand-700">Tư vấn bất động sản</p>
            <h1 class="mt-2 text-3xl font-semibold text-ink">Liên hệ An Phú để tìm căn hộ phù hợp</h1>
            <p class="mt-3 text-sm text-muted">Gửi nhu cầu thuê, mua hoặc xem căn. Đội ngũ phụ trách sẽ liên hệ lại theo thông tin bạn để lại.</p>
            <div class="mt-5 grid gap-3 text-sm text-ink">
                <div class="fb-card p-4">
                    <p class="font-semibold">Văn phòng tư vấn</p>
                    <p class="mt-1 text-muted">Vinhomes Grand Park, TP. Thủ Đức, TP. Hồ Chí Minh</p>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="fb-card p-4">
                        <p class="font-semibold">Liên hệ nhanh</p>
                        <p class="mt-1 text-muted"><a class="hover:text-brand-800" href="tel:0901111222">0901 111 222</a></p>
                        <p class="mt-1 text-muted"><a class="hover:text-brand-800" href="mailto:hello@anphu.realestate">hello@anphu.realestate</a></p>
                    </div>
                    <div class="fb-card p-4">
                        <p class="font-semibold">Kênh chat</p>
                        <div class="mt-1 grid gap-1 text-muted">
                            <a class="hover:text-brand-800" href="https://zalo.me/0901111222" rel="noopener">Zalo tư vấn</a>
                            <a class="hover:text-brand-800" href="https://wa.me/84901111222" rel="noopener">WhatsApp</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="overflow-hidden rounded-ui border border-line bg-white shadow-sm">
            <img class="h-72 w-full object-cover" src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80" alt="Phòng khách căn hộ hiện đại" />
        </div>
    </div>
</section>

<section class="fb-container grid gap-5 py-8 lg:grid-cols-[0.75fr_minmax(0,720px)]">
    <div>
        <h2 class="fb-section-title">Gửi yêu cầu tư vấn</h2>
        <p class="fb-muted mt-2">Bạn không cần đăng nhập. Thông tin này chỉ dùng để đội ngũ tư vấn liên hệ lại.</p>
    </div>
    <form class="fb-card grid gap-4 p-5" method="post" action="/contact">
        @Html.AntiForgeryToken()
        @if (TempData["SuccessMessage"] is string success)
        {
            <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Đã nhận thông tin", success, "success")' />
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <partial name="~/Views/Shared/Partials/_Alert.cshtml" model='new AlertViewModel("Không thể gửi yêu cầu", error, "danger")' />
        }
        <div asp-validation-summary="ModelOnly" class="text-sm text-danger"></div>
        <input asp-for="Language" type="hidden" value="vi" />
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="fb-label" asp-for="Name"></label>
                <input class="fb-input" asp-for="Name" autocomplete="name" />
                <span class="mt-1 block text-xs text-danger" asp-validation-for="Name"></span>
            </div>
            <div>
                <label class="fb-label" asp-for="Contact"></label>
                <input class="fb-input" asp-for="Contact" autocomplete="email tel" />
                <span class="mt-1 block text-xs text-danger" asp-validation-for="Contact"></span>
            </div>
        </div>
        <div>
            <label class="fb-label" asp-for="Subject"></label>
            <input class="fb-input" asp-for="Subject" />
            <span class="mt-1 block text-xs text-danger" asp-validation-for="Subject"></span>
        </div>
        <div>
            <label class="fb-label" asp-for="Message"></label>
            <textarea class="fb-input min-h-32" asp-for="Message"></textarea>
            <span class="mt-1 block text-xs text-danger" asp-validation-for="Message"></span>
        </div>
        <button class="fb-button fb-button-primary justify-center" type="submit">Gửi yêu cầu</button>
    </form>
</section>
