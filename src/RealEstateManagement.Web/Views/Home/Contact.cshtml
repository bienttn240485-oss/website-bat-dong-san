@{
    ViewData["Title"] = "Liên hệ";
}

<section class="border-b border-line bg-white">
    <div class="fb-container grid gap-6 py-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
            <p class="text-sm font-semibold uppercase text-brand-700">Liên hệ sân bóng</p>
            <h1 class="mt-2 text-3xl font-semibold text-ink">Sân bóng An Phú luôn sẵn sàng hỗ trợ lịch chơi</h1>
            <p class="mt-3 text-sm text-muted">Gọi trực tiếp để hỏi khung giờ trống, dịch vụ đi kèm hoặc cần hỗ trợ tra cứu lượt đặt sân.</p>
            <div class="mt-5 grid gap-3 text-sm text-ink">
                <div class="fb-card p-4">
                    <p class="font-semibold">Địa chỉ</p>
                    <p class="mt-1 text-muted">12 đường D5, Phường 25, Quận Bình Thạnh, Thành phố Hồ Chí Minh</p>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="fb-card p-4">
                        <p class="font-semibold">Điện thoại</p>
                        <p class="mt-1 text-muted">0901 234 567</p>
                    </div>
                    <div class="fb-card p-4">
                        <p class="font-semibold">Giờ mở cửa</p>
                        <p class="mt-1 text-muted">06:00 - 23:00 mỗi ngày</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="overflow-hidden rounded-ui border border-line bg-white shadow-sm">
            <img class="h-72 w-full object-cover" src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=1200&q=80" alt="Sân bóng cỏ nhân tạo có đèn chiếu sáng" />
        </div>
    </div>
</section>

<section class="fb-container grid gap-5 py-8 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
        <h2 class="fb-section-title">Gửi yêu cầu hỗ trợ</h2>
        <p class="fb-muted mt-2">Biểu mẫu này là khung giao diện để tiếp nhận thông tin liên hệ trong phiên bản phát triển.</p>
    </div>
    <form class="fb-card grid gap-4 p-4">
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="fb-label" for="contact-name">Họ và tên</label>
                <input class="fb-input" id="contact-name" type="text" value="Nguyễn Minh Tuấn" />
            </div>
            <div>
                <label class="fb-label" for="contact-phone">Số điện thoại</label>
                <input class="fb-input" id="contact-phone" type="tel" value="0901 234 567" />
            </div>
        </div>
        <div>
            <label class="fb-label" for="contact-message">Nội dung cần hỗ trợ</label>
            <textarea class="fb-input min-h-28" id="contact-message">Tôi muốn hỏi khung giờ trống cho sân 5 người tối nay.</textarea>
        </div>
        <button class="fb-button fb-button-primary justify-center" type="button">Gửi yêu cầu</button>
    </form>
</section>
