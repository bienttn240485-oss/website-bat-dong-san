@model RealEstateManagement.Web.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="relative overflow-hidden bg-white">
    <img class="absolute inset-0 h-full w-full object-cover" src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=80" alt="Không gian căn hộ hiện đại" />
    <div class="absolute inset-0 bg-slate-950/55"></div>
    <div class="fb-container relative grid min-h-[560px] items-center py-10 text-white lg:grid-cols-[0.95fr_1.05fr]">
        <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase">An Phú Real Estate</p>
            <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">Thuê và mua căn hộ tại Vinhomes Grand Park</h1>
            <p class="mt-4 max-w-2xl text-base text-white/85">Lọc nhanh theo phân khu, loại căn và ngân sách. Đội ngũ tư vấn hỗ trợ xem căn, thương lượng giá và chuẩn bị thông tin giao dịch rõ ràng.</p>
            <form class="mt-6 grid gap-3 rounded-ui border border-white/20 bg-white/95 p-4 text-ink shadow-sm sm:grid-cols-[1.2fr_1fr_auto]" action="/properties" method="get">
                <div>
                    <label class="fb-label" for="home-keyword">Từ khóa</label>
                    <input class="fb-input" id="home-keyword" name="Keyword" type="search" placeholder="" />
                </div>
                <div>
                    <label class="fb-label" for="home-area">Phân khu</label>
                    <input class="fb-input" id="home-area" name="Area" type="text" />
                </div>
                <div class="flex items-end">
                    <button class="fb-button fb-button-primary w-full justify-center" type="submit">Tìm căn thuê</button>
                </div>
            </form>
            <div class="mt-4 flex flex-wrap gap-3">
                <a class="fb-button fb-button-primary" href="/properties">Xem căn cho thuê</a>
                <a class="fb-button fb-button-secondary bg-white text-ink hover:bg-slate-100" href="/sales">Xem căn bán</a>
            </div>
        </div>
    </div>
</section>

<section class="fb-container py-8">
    <div class="grid gap-4 md:grid-cols-4">
        @foreach (var area in new[] { "Origami", "Glory Heights", "Beverly", "Masteri Centre Point" })
        {
            <a class="fb-card p-4 hover:border-brand-700" href="/properties?Area=@Uri.EscapeDataString(area)">
                <span class="text-sm font-semibold text-ink">@area</span>
                <span class="mt-1 block text-sm text-muted">Xem căn đang có nhu cầu thuê hoặc mua.</span>
            </a>
        }
    </div>
</section>

<section class="fb-container py-8">
    <div class="mb-4 flex items-end justify-between gap-4">
        <div>
            <h2 class="fb-section-title">Căn cho thuê nổi bật</h2>
            <p class="fb-muted mt-1">Dữ liệu được lấy từ hệ thống quản lý căn hộ.</p>
        </div>
        <a class="hidden text-sm font-semibold text-brand-800 hover:text-brand-900 sm:inline" href="/properties">Xem tất cả</a>
    </div>
    @if (Model.FeaturedRentals.Count == 0)
    {
        <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có căn cho thuê", "Hệ thống chưa có căn phù hợp để hiển thị công khai.", IconName: "building-office")' />
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-3">
            @foreach (var property in Model.FeaturedRentals)
            {
                <article class="fb-card overflow-hidden">
                    <partial name="~/Views/Shared/Partials/_PublicPropertyImage.cshtml" model='new RealEstateManagement.Web.ViewModels.PublicPropertyImageViewModel(property.ImageUrl, property.ImageAltText, "aspect-[16/10] w-full object-cover")' />
                    <div class="grid gap-3 p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="font-semibold text-ink">Mã tham chiếu: @property.PublicReferenceCode</h3>
                                <p class="text-sm text-muted">@property.ProjectLabel · @property.Area</p>
                            </div>
                            <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(property.StatusLabel, property.StatusTone)' />
                        </div>
                        <p class="text-sm text-muted">@property.TypeLabel · @property.AreaText · @property.BathroomText</p>
                        <div class="flex items-center justify-between gap-3">
                            <span class="font-semibold text-brand-800">@property.PriceText</span>
                            <a class="text-sm font-semibold text-brand-800 hover:text-brand-900" href="@property.DetailUrl">Chi tiết</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="border-y border-line bg-white">
    <div class="fb-container grid gap-6 py-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
            <h2 class="fb-section-title">Dịch vụ chính</h2>
            <p class="fb-muted mt-2">Tư vấn đúng nhu cầu, cập nhật tình trạng căn và hỗ trợ khách hàng từ lúc tìm căn đến khi ký kết.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
            @foreach (var item in new[] { "Tìm căn theo ngân sách", "Tư vấn pháp lý và phí", "Kết nối xem căn nhanh" })
            {
                <div class="rounded-ui border border-line bg-slate-50 p-4 text-sm font-medium text-ink">@item</div>
            }
        </div>
    </div>
</section>

<section class="fb-container py-8">
    <div class="mb-4 flex items-end justify-between gap-4">
        <div>
            <h2 class="fb-section-title">Căn bán nổi bật</h2>
            <p class="fb-muted mt-1">Các căn đang có giá bán và thông tin tư vấn công khai.</p>
        </div>
        <a class="hidden text-sm font-semibold text-brand-800 hover:text-brand-900 sm:inline" href="/sales">Xem tất cả</a>
    </div>
    @if (Model.FeaturedSales.Count == 0)
    {
        <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có căn bán", "Hệ thống chưa có căn bán phù hợp để hiển thị.", IconName: "building-office")' />
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-3">
            @foreach (var property in Model.FeaturedSales)
            {
                <article class="fb-card overflow-hidden">
                    <partial name="~/Views/Shared/Partials/_PublicPropertyImage.cshtml" model='new RealEstateManagement.Web.ViewModels.PublicPropertyImageViewModel(property.ImageUrl, property.ImageAltText, "aspect-[16/10] w-full object-cover")' />
                    <div class="grid gap-3 p-4">
                        <h3 class="font-semibold text-ink">Mã tham chiếu: @property.PublicReferenceCode</h3>
                        <p class="text-sm text-muted">@property.ProjectLabel · @property.Area · @property.TypeLabel</p>
                        <div class="flex items-center justify-between gap-3">
                            <span class="font-semibold text-brand-800">@property.PriceText</span>
                            <a class="text-sm font-semibold text-brand-800 hover:text-brand-900" href="@property.DetailUrl">Chi tiết</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="fb-container py-8">
    <div class="rounded-ui border border-line bg-white p-5 shadow-sm sm:flex sm:items-center sm:justify-between sm:gap-5">
        <div>
            <h2 class="text-xl font-semibold text-ink">Cần tư vấn căn phù hợp?</h2>
            <p class="mt-1 text-sm text-muted">Gửi nhu cầu, An Phú sẽ liên hệ lại qua số điện thoại, Zalo, WhatsApp hoặc email bạn cung cấp.</p>
        </div>
        <a class="fb-button fb-button-primary mt-4 sm:mt-0" href="/contact">Gửi yêu cầu tư vấn</a>
    </div>
</section>
