@model ServiceListViewModel
@{
    ViewData["Title"] = "Dịch vụ";
}
@functions {
    private static string FormatMoney(long amount) => string.Format("{0:N0} ₫", amount).Replace(",", ".");
}

<section class="border-b border-line bg-white">
    <div class="fb-container py-8">
        <p class="text-sm font-semibold uppercase text-brand-800">Dịch vụ</p>
        <h1 class="mt-2 text-3xl font-semibold text-ink">Dịch vụ đi kèm khi đặt sân</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">Chọn thêm bóng, áo phân đội, nước uống hoặc trọng tài ngay trong form đặt sân để nhân viên chuẩn bị trước giờ thi đấu.</p>
    </div>
</section>

<section class="fb-container py-8">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        @foreach (var service in Model.Services)
        {
            <article class="fb-card p-4">
                <h2 class="font-semibold text-ink">@service.Name</h2>
                <p class="mt-2 min-h-12 text-sm text-muted">@service.Description</p>
                <p class="mt-4 text-lg font-semibold text-brand-900">@FormatMoney(service.UnitPrice)</p>
                <p class="text-xs text-muted">Tính theo @service.UnitName</p>
            </article>
        }
    </div>
</section>
