@model RealEstateManagement.Web.ViewModels.PublicPropertyListViewModel
@using RealEstateManagement.Web.ViewModels
@using RealEstateManagement.Web.ViewModels.Shared
@using System.Text.Json
@{
    ViewData["Title"] = Model.Title;
}

<section class="border-b border-line bg-white">
    <div class="fb-container py-6">
        <p class="text-sm font-semibold uppercase text-brand-700">An Phú Real Estate</p>
        <div class="mt-2 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
                <h1 class="text-3xl font-semibold text-ink">@Model.Title</h1>
                <p class="mt-2 max-w-2xl text-sm text-muted">@Model.Subtitle</p>
            </div>
            <a class="fb-button fb-button-primary" href="/contact">Gửi nhu cầu tư vấn</a>
        </div>
    </div>
</section>

<section class="fb-container grid gap-5 py-6 lg:grid-cols-[300px_1fr] xl:grid-cols-[320px_1fr]">
    <aside class="fb-filter-panel">
        <h2 class="text-base font-semibold text-ink">Bộ lọc</h2>
        <form class="mt-4 grid gap-3" method="get" action="@Model.FormAction">
            <div asp-validation-summary="ModelOnly" class="rounded-ui border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"></div>
            <div>
                <label class="fb-label" asp-for="Filter.Keyword"></label>
                <input class="fb-input" asp-for="Filter.Keyword" name="Keyword" type="search" placeholder="Tìm mã tham chiếu, phân khu, loại căn…" />
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Project"></label>
                <select class="fb-input" asp-for="Filter.Project" name="Project" asp-items="Model.ProjectOptions" data-project-select></select>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Area"></label>
                <select class="fb-input" asp-for="Filter.Area" name="Area" asp-items="Model.AreaOptions" data-area-select></select>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.Type"></label>
                <select class="fb-input" asp-for="Filter.Type" name="Type" asp-items="Model.TypeOptions"></select>
            </div>
            @if (!Model.IsSaleMode)
            {
                <div>
                    <label class="fb-label" asp-for="Filter.Status"></label>
                    <select class="fb-input" asp-for="Filter.Status" name="Status" asp-items="Model.StatusOptions"></select>
                </div>
            }
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                <div>
                    <label class="fb-label" asp-for="Filter.RentalPriceFromMillion"></label>
                    <div class="flex overflow-hidden rounded-ui border border-line bg-white focus-within:border-brand-600">
                        <input class="fb-input border-0" asp-for="Filter.RentalPriceFromMillion" name="RentalPriceFromMillion" type="text" inputmode="decimal" placeholder="Từ 8 triệu" />
                        <span class="grid place-items-center border-l border-line px-3 text-xs text-muted">triệu đồng/tháng</span>
                    </div>
                    <span asp-validation-for="Filter.RentalPriceFromMillion" class="text-xs text-red-700"></span>
                </div>
                <div>
                    <label class="fb-label" asp-for="Filter.RentalPriceToMillion"></label>
                    <div class="flex overflow-hidden rounded-ui border border-line bg-white focus-within:border-brand-600">
                        <input class="fb-input border-0" asp-for="Filter.RentalPriceToMillion" name="RentalPriceToMillion" type="text" inputmode="decimal" placeholder="Đến 30 triệu" />
                        <span class="grid place-items-center border-l border-line px-3 text-xs text-muted">triệu đồng/tháng</span>
                    </div>
                    <span asp-validation-for="Filter.RentalPriceToMillion" class="text-xs text-red-700"></span>
                </div>
            </div>
            <div>
                <label class="fb-label" asp-for="Filter.SortBy"></label>
                <select class="fb-input" asp-for="Filter.SortBy" name="SortBy" asp-items="PublicPropertyDisplay.SortOptions(Model.Filter.SortBy)"></select>
            </div>
            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                <button class="fb-button fb-button-primary justify-center" type="submit">Áp dụng</button>
                <a class="fb-button fb-button-secondary justify-center" href="@Model.FormAction">Xóa lọc</a>
            </div>
        </form>
        <script type="application/json" data-area-options-json>
            @Html.Raw(JsonSerializer.Serialize(Model.AreaSuggestions))
        </script>
    </aside>

    <div class="grid gap-4">
        <div class="flex items-center justify-between gap-3">
            <p class="text-sm text-muted">Tìm thấy <span class="font-semibold text-ink">@Model.Properties.Count</span> căn phù hợp</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Filter.RentalPriceSummary()))
        {
            <p class="text-sm text-muted">@Model.Filter.RentalPriceSummary()</p>
        }

        @if (Model.Properties.Count == 0)
        {
            <partial name="~/Views/Shared/Partials/_EmptyState.cshtml" model='new EmptyStateViewModel("Chưa có căn phù hợp", "Thử đổi bộ lọc hoặc gửi nhu cầu để đội ngũ tư vấn kiểm tra thêm.", "Gửi yêu cầu", "/contact", "building-office")' />
        }
        else
        {
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var property in Model.Properties)
                {
                    <article class="fb-property-card">
                        <partial name="~/Views/Shared/Partials/_PublicPropertyImage.cshtml" model='new PublicPropertyImageViewModel(property.ImageUrl, property.ImageAltText, "aspect-[16/10] w-full object-cover")' />
                        <div class="fb-property-card-body">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <h2 class="font-semibold text-ink">Mã tham chiếu: @property.PublicReferenceCode</h2>
                                    <p class="text-sm text-muted">@property.ProjectLabel · @property.Area</p>
                                </div>
                                @if (!Model.IsSaleMode)
                                {
                                    <partial name="~/Views/Shared/Partials/_StatusBadge.cshtml" model='new StatusBadgeViewModel(property.StatusLabel, property.StatusTone)' />
                                }
                            </div>
                            <p class="text-sm text-muted">@property.TypeLabel · @property.AreaText · @property.BathroomText</p>
                            @if (!string.IsNullOrWhiteSpace(property.AvailableFromText))
                            {
                                <p class="text-xs font-medium text-brand-800">Có thể vào ở từ @property.AvailableFromText</p>
                            }
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="fb-price">@property.PriceText</p>
                                    @if (!string.IsNullOrWhiteSpace(property.SecondaryPriceText))
                                    {
                                        <p class="text-xs text-muted">@property.SecondaryPriceText</p>
                                    }
                                </div>
                                <a class="fb-button fb-button-secondary shrink-0 px-3" href="@property.DetailUrl">Xem chi tiết</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
