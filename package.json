{
  "name": "real-estate-management",
  "version": "1.0.0",
  "description": "Real estate management ASP.NET Core MVC application.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "css:dev": "tailwindcss -i ./src/RealEstateManagement.Web/Styles/input.css -o ./src/RealEstateManagement.Web/wwwroot/css/site.css --watch",
    "js:dev": "esbuild ./src/RealEstateManagement.Web/Scripts/site.js ./src/RealEstateManagement.Web/Scripts/admin-reports.js --bundle --format=iife --sourcemap --outdir=./src/RealEstateManagement.Web/wwwroot/js --watch",
    "dev": "concurrently \"npm:css:dev\" \"npm:js:dev\"",
    "css:build": "tailwindcss -i ./src/RealEstateManagement.Web/Styles/input.css -o ./src/RealEstateManagement.Web/wwwroot/css/site.css --minify",
    "js:build": "esbuild ./src/RealEstateManagement.Web/Scripts/site.js ./src/RealEstateManagement.Web/Scripts/admin-reports.js --bundle --format=iife --minify --outdir=./src/RealEstateManagement.Web/wwwroot/js",
    "build": "npm run css:build && npm run js:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "preline": "^4.2.0"
  }
}
